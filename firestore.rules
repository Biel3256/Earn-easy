rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity health check document
    match /test/connection {
      allow get: if true;
    }

    // --- Global Security Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPromoCodeId(code) {
      return code is string && code.size() >= 3 && code.size() <= 40 && code.matches('^[A-Z0-9_\\-]+$');
    }

    function isValidPhotoUrl(url) {
      return url is string && (
        (url.size() <= 1000 && !url.matches('^data:.*')) ||
        (url.size() <= 60000 && url.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]{16,}.*'))
      );
    }

    function isValidSelfieDataUrl(url) {
      return url is string &&
        url.size() >= 64 &&
        url.size() <= 85000 &&
        url.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]{16,}.*');
    }

    function isValidPrivateMediaDataUrl(url) {
      return url is string &&
        url.size() >= 32 &&
        url.size() <= 350000 && (
          url.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]{16,}.*') ||
          url.matches('^data:audio/(webm|mp4|ogg|mpeg|wav|aac|x-m4a)(;codecs=[a-zA-Z0-9._-]+)?;base64,[A-Za-z0-9+/=]{16,}.*')
        );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function hasVerifiedEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlatformOwner() {
      return isSignedIn() && (
        request.auth.uid == 'H93H113NSHg0K3ircdUTe7fY0Gt1' ||
        (hasVerifiedEmail() && request.auth.token.email == 'riel6359@gmail.com')
      );
    }

    function isBootstrappedAdmin() {
      return isPlatformOwner();
    }

    function isProtectedOwnerAccount(userId) {
      return userId == 'H93H113NSHg0K3ircdUTe7fY0Gt1' ||
        (
          exists(/databases/$(database)/documents/users/$(userId)/private/info) &&
          get(/databases/$(database)/documents/users/$(userId)/private/info).data.email == 'riel6359@gmail.com'
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(userId)) &&
          'verifiedBadge' in get(/databases/$(database)/documents/users/$(userId)).data &&
          get(/databases/$(database)/documents/users/$(userId)).data.verifiedBadge == 'owner'
        );
    }

    function isAdmin() {
      return isPlatformOwner() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidOptionalDateStr(d) {
      return d is string && (d == '' || (d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    function dateStrFromTime(t) {
      return string(t.year()) + '-' +
        (t.month() < 10 ? '0' + string(t.month()) : string(t.month())) + '-' +
        (t.day() < 10 ? '0' + string(t.day()) : string(t.day()));
    }

    function serverDateStr() {
      return dateStrFromTime(request.time);
    }

    function yesterdayDateStr() {
      return dateStrFromTime(request.time - duration.value(24, 'h'));
    }

    function checkinDocId(userId) {
      return 'chk_' + userId + '_' + serverDateStr();
    }

    function yesterdayCheckinDocId(userId) {
      return 'chk_' + userId + '_' + yesterdayDateStr();
    }

    function levelRewardDocId(userId, lvl) {
      return 'lvl_' + userId + '_' + string(lvl);
    }

    function promoRedemptionDocId(userId, code) {
      return 'prm_' + userId + '_' + code;
    }

    function userXp(data) {
      return data.lifetimePoints + (data.gamesPlayed * 25);
    }

    function isActiveUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) && (
        !('status' in get(/databases/$(database)/documents/users/$(userId)).data) ||
        get(/databases/$(database)/documents/users/$(userId)).data.status == null ||
        get(/databases/$(database)/documents/users/$(userId)).data.status == 'active' ||
        (
          get(/databases/$(database)/documents/users/$(userId)).data.status == 'suspended' &&
          'suspensionUntil' in get(/databases/$(database)/documents/users/$(userId)).data &&
          get(/databases/$(database)/documents/users/$(userId)).data.suspensionUntil is timestamp &&
          get(/databases/$(database)/documents/users/$(userId)).data.suspensionUntil <= request.time
        )
      );
    }

    function isPromoPublished(promoData) {
      return !('publishAt' in promoData) || promoData.publishAt == null || promoData.publishAt <= request.time;
    }

    function withdrawalSettingsExists() {
      return exists(/databases/$(database)/documents/appSettings/withdrawal);
    }

    function withdrawalSettings() {
      return get(/databases/$(database)/documents/appSettings/withdrawal).data;
    }

    function activeFirstMinCents() {
      return withdrawalSettingsExists() ? withdrawalSettings().firstWithdrawalMinCents : 10;
    }

    function activeStandardMinCents() {
      return withdrawalSettingsExists() ? withdrawalSettings().standardWithdrawalMinCents : 500;
    }

    function isFirstWithdrawalEligible(userData) {
      return userData.totalWithdrawnCents == 0 &&
        (!('firstWithdrawalUsed' in userData) || userData.firstWithdrawalUsed == false);
    }

    function requiredWithdrawalMinCents(userData) {
      return isFirstWithdrawalEligible(userData)
        ? activeFirstMinCents()
        : activeStandardMinCents();
    }

    function validateReferralCommissionPair(comm, referrerUid, refBefore, refAfter, invitedBefore, invitedAfter) {
      return refBefore != null &&
        refAfter != null &&
        invitedBefore != null &&
        invitedAfter != null &&
        comm >= 1 &&
        comm <= 60 &&
        refBefore.data.referrerUid == referrerUid &&
        (refAfter.data.totalCommissionPointsEarned - refBefore.data.totalCommissionPointsEarned) == comm &&
        (invitedAfter.data.lifetimePoints - invitedBefore.data.lifetimePoints) > 0 &&
        (comm * 100) <= ((invitedAfter.data.lifetimePoints - invitedBefore.data.lifetimePoints) * 12) &&
        ((comm + 1) * 100) > ((invitedAfter.data.lifetimePoints - invitedBefore.data.lifetimePoints) * 12);
    }

    function isValidReferralCommission(comm, referrerUid, invitedUid) {
      return comm >= 1 &&
        comm <= 60 &&
        validateReferralCommissionPair(
          comm,
          referrerUid,
          get(/databases/$(database)/documents/referrals/$(invitedUid)),
          getAfter(/databases/$(database)/documents/referrals/$(invitedUid)),
          get(/databases/$(database)/documents/users/$(invitedUid)),
          getAfter(/databases/$(database)/documents/users/$(invitedUid))
        );
    }

    function validateUserCheckinAction(checkinAfterData, ptsDelta, brlDelta) {
      return checkinAfterData.pointsAwarded == ptsDelta &&
        checkinAfterData.brlBonusCents == brlDelta &&
        (brlDelta == 0 || (brlDelta == 1000 && checkinAfterData.streakDay == 30));
    }

    function validateUserPromoAction(promoData, redemptionAfterData, ptsDelta) {
      return promoData.active == true &&
        isPromoPublished(promoData) &&
        promoData.redemptionCount < promoData.maxRedemptions &&
        ptsDelta == promoData.pointsValue &&
        redemptionAfterData.pointsAwarded == ptsDelta;
    }

    function validateYesterdayStreak(yData, incomingStreak) {
      return (
        (!('streakDay' in yData) || !(yData.streakDay is number) || yData.streakDay <= 0) &&
        incomingStreak == 2
      ) || (
        ('streakDay' in yData) &&
        yData.streakDay is number &&
        yData.streakDay >= 30 &&
        incomingStreak == 1
      ) || (
        ('streakDay' in yData) &&
        yData.streakDay is number &&
        yData.streakDay >= 1 &&
        yData.streakDay < 30 &&
        incomingStreak == yData.streakDay + 1
      );
    }

    function matchesUserLeaderboard(userId, userAfterData, lbData) {
      return (!('uid' in userAfterData) || userAfterData.uid == null || userAfterData.uid == userId) &&
        ((('status' in userAfterData) && userAfterData.status != null && userAfterData.status == lbData.status) || ((!('status' in userAfterData) || userAfterData.status == null) && lbData.status == 'active')) &&
        ((('displayName' in userAfterData) && userAfterData.displayName != null && userAfterData.displayName != '' && userAfterData.displayName == lbData.displayName) || ((!('displayName' in userAfterData) || userAfterData.displayName == null || userAfterData.displayName == '') && lbData.displayName == 'Jogador')) &&
        ((('photoURL' in userAfterData) && userAfterData.photoURL != null && userAfterData.photoURL == lbData.photoURL) || ((!('photoURL' in userAfterData) || userAfterData.photoURL == null) && lbData.photoURL == '')) &&
        ((('brlBalanceCents' in userAfterData) && userAfterData.brlBalanceCents != null && userAfterData.brlBalanceCents == lbData.brlBalanceCents) || ((!('brlBalanceCents' in userAfterData) || userAfterData.brlBalanceCents == null) && lbData.brlBalanceCents == 0)) &&
        ((('pointsBalance' in userAfterData) && userAfterData.pointsBalance != null && userAfterData.pointsBalance == lbData.pointsBalance) || ((!('pointsBalance' in userAfterData) || userAfterData.pointsBalance == null) && lbData.pointsBalance == 0)) &&
        (!('lifetimePoints' in lbData) || (('lifetimePoints' in userAfterData) && userAfterData.lifetimePoints != null && userAfterData.lifetimePoints == lbData.lifetimePoints) || ((!('lifetimePoints' in userAfterData) || userAfterData.lifetimePoints == null) && lbData.lifetimePoints == 0)) &&
        ((('gamesPlayed' in userAfterData) && userAfterData.gamesPlayed != null && userAfterData.gamesPlayed == lbData.gamesPlayed) || ((!('gamesPlayed' in userAfterData) || userAfterData.gamesPlayed == null) && lbData.gamesPlayed == 0)) &&
        (!('identityVerified' in lbData) || (
          (('identityVerified' in userAfterData) && userAfterData.identityVerified != null && lbData.identityVerified == userAfterData.identityVerified) ||
          ((!('identityVerified' in userAfterData) || userAfterData.identityVerified == null) && lbData.identityVerified == false)
        )) &&
        (!('verifiedBadge' in lbData) || (
          (('verifiedBadge' in userAfterData) && userAfterData.verifiedBadge != null && (
            lbData.verifiedBadge == userAfterData.verifiedBadge ||
            (userAfterData.verifiedBadge == 'none' && lbData.verifiedBadge == 'blue' && ('identityVerified' in userAfterData) && userAfterData.identityVerified == true)
          )) ||
          ((!('verifiedBadge' in userAfterData) || userAfterData.verifiedBadge == null) && (
            lbData.verifiedBadge == 'none' ||
            (lbData.verifiedBadge == 'blue' && ('identityVerified' in userAfterData) && userAfterData.identityVerified == true)
          ))
        ));
    }

    function validatePromoRedemptionCreate(promoData, userBeforeData, userAfterData, reqData) {
      return userBeforeData.status == 'active' &&
        promoData.active == true &&
        isPromoPublished(promoData) &&
        promoData.redemptionCount < promoData.maxRedemptions &&
        reqData.pointsAwarded == promoData.pointsValue &&
        userAfterData.pointsBalance == userBeforeData.pointsBalance + reqData.pointsAwarded;
    }

    function validateWithdrawalCreateUser(userBeforeData, userAfterData, reqData) {
      return userBeforeData.status == 'active' &&
        reqData.amountCents >= requiredWithdrawalMinCents(userBeforeData) &&
        userAfterData.brlBalanceCents == userBeforeData.brlBalanceCents - reqData.amountCents &&
        userAfterData.firstWithdrawalUsed == true;
    }

    function validateLevelRewardClaim(userBeforeData, userAfterData, reqData) {
      return userBeforeData.status == 'active' &&
        reqData.xpAtClaim >= 1000 &&
        reqData.xpAtClaim <= userXp(userBeforeData) &&
        userAfterData.pointsBalance == userBeforeData.pointsBalance + reqData.rewardPoints && (
          (reqData.level == 2 && userXp(userBeforeData) >= 1000) ||
          (reqData.level == 3 && userXp(userBeforeData) >= 3000) ||
          (reqData.level == 4 && userXp(userBeforeData) >= 7000) ||
          (reqData.level == 5 && userXp(userBeforeData) >= 15000) ||
          (reqData.level == 6 && userXp(userBeforeData) >= 30000)
        );
    }

    function canCreateUserSupportMessage(ticketData, msgData) {
      return ticketData.userId == request.auth.uid &&
        ticketData.status != 'closed' &&
        msgData.senderRole in ['user', 'biel'];
    }

    // --- Validation Blueprints ---
    function isValidUserAccount(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'photoURL', 'pointsBalance', 'lifetimePoints',
        'brlBalanceCents', 'totalWithdrawnCents', 'lastConversionDate',
        'status', 'riskScore', 'gamesPlayed', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'photoURL', 'pointsBalance', 'lifetimePoints',
        'brlBalanceCents', 'totalWithdrawnCents', 'lastConversionDate',
        'status', 'riskScore', 'gamesPlayed', 'banReason', 'banExplanation',
        'bannedBy', 'suspensionUntil', 'lastPromoCode', 'firstWithdrawalUsed',
        'lastMpMatchId', 'lastCasinoSessionId',
        'birthDate', 'ageVerified', 'ageVerifiedAt', 'identityVerified',
        'verifiedBadge', 'verificationStatus', 'verificationNote',
        'faceVerificationStatus', 'faceVerificationNote', 'verifiedAt',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
      isValidPhotoUrl(data.photoURL) &&
      data.pointsBalance is number && data.pointsBalance >= 0 &&
      data.lifetimePoints is number && data.lifetimePoints >= 0 &&
      data.brlBalanceCents is number && data.brlBalanceCents >= 0 &&
      data.totalWithdrawnCents is number && data.totalWithdrawnCents >= 0 &&
      isValidOptionalDateStr(data.lastConversionDate) &&
      data.status in ['active', 'suspended', 'flagged'] &&
      data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100 &&
      data.gamesPlayed is number && data.gamesPlayed >= 0 &&
      (!('banReason' in data) || (data.banReason is string && data.banReason.size() <= 120)) &&
      (!('banExplanation' in data) || (data.banExplanation is string && data.banExplanation.size() <= 400)) &&
      (!('bannedBy' in data) || (data.bannedBy is string && data.bannedBy.size() <= 160)) &&
      (!('suspensionUntil' in data) || data.suspensionUntil == null || data.suspensionUntil is timestamp) &&
      (!('lastPromoCode' in data) || isValidPromoCodeId(data.lastPromoCode)) &&
      (!('firstWithdrawalUsed' in data) || data.firstWithdrawalUsed is bool) &&
      (!('lastMpMatchId' in data) || isValidId(data.lastMpMatchId)) &&
      (!('lastCasinoSessionId' in data) || isValidId(data.lastCasinoSessionId)) &&
      (!('birthDate' in data) || isValidOptionalDateStr(data.birthDate)) &&
      (!('ageVerified' in data) || data.ageVerified is bool) &&
      (!('ageVerifiedAt' in data) || data.ageVerifiedAt == null || data.ageVerifiedAt is timestamp) &&
      (!('identityVerified' in data) || data.identityVerified is bool) &&
      (!('verifiedBadge' in data) || data.verifiedBadge in ['none', 'blue', 'owner']) &&
      (!('verificationStatus' in data) || data.verificationStatus in ['none', 'pending', 'approved', 'rejected']) &&
      (!('verificationNote' in data) || (data.verificationNote is string && data.verificationNote.size() <= 240)) &&
      (!('faceVerificationStatus' in data) || data.faceVerificationStatus in ['none', 'pending', 'approved', 'rejected']) &&
      (!('faceVerificationNote' in data) || (data.faceVerificationNote is string && data.faceVerificationNote.size() <= 240)) &&
      (!('verifiedAt' in data) || data.verifiedAt == null || data.verifiedAt is timestamp) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll([
        'uid', 'email', 'defaultPixKeyType', 'defaultPixKey', 'deviceFingerprint', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'email', 'defaultPixKeyType', 'defaultPixKey', 'deviceFingerprint', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      data.defaultPixKeyType in ['none', 'cpf', 'email', 'phone', 'random'] &&
      data.defaultPixKey is string && data.defaultPixKey.size() <= 140 &&
      data.deviceFingerprint is string && data.deviceFingerprint.size() <= 128 &&
      data.updatedAt is timestamp;
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt']) &&
      data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt']) &&
      isValidId(data.uid) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
      data.createdAt is timestamp;
    }

    function isValidGameSession(data) {
      return data.keys().hasAll([
        'sessionId', 'userId', 'gameCategory', 'scoreEarned', 'durationMs',
        'movesCount', 'integrityHash', 'verificationStatus', 'fraudReason',
        'playedDate', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'sessionId', 'userId', 'gameCategory', 'scoreEarned', 'durationMs',
        'movesCount', 'integrityHash', 'verificationStatus', 'fraudReason',
        'playedDate', 'createdAt'
      ]) &&
      isValidId(data.sessionId) &&
      isValidId(data.userId) &&
      data.gameCategory in ['tic_tac_toe', 'dot_link', 'word_search', 'math_sprint', 'memory_match', 'quick_reflex', 'high_low_cards', 'block_britz', 'domino_solo', 'stop_solo', 'draw_guess_solo', 'battleship_solo', 'connect4_solo', 'quiz_solo', 'rps_solo', 'guess_number_solo'] &&
      data.scoreEarned is number && data.scoreEarned >= 0 && data.scoreEarned <= 500 &&
      data.durationMs is number && data.durationMs >= 3000 &&
      data.movesCount is number && data.movesCount >= 1 &&
      data.integrityHash is string && data.integrityHash.size() >= 16 && data.integrityHash.size() <= 128 &&
      data.verificationStatus in ['verified', 'flagged', 'rejected'] &&
      data.fraudReason is string && data.fraudReason.size() <= 200 &&
      isValidDateStr(data.playedDate) &&
      data.createdAt is timestamp;
    }

    function isValidConversion(data) {
      return data.keys().hasAll([
        'conversionId', 'userId', 'pointsConverted', 'brlCentsCredited',
        'conversionDate', 'captchaVerified', 'integrityToken', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'conversionId', 'userId', 'pointsConverted', 'brlCentsCredited',
        'conversionDate', 'captchaVerified', 'integrityToken', 'createdAt'
      ]) &&
      isValidId(data.conversionId) &&
      isValidId(data.userId) &&
      data.pointsConverted is number && data.pointsConverted >= 1000 && (data.pointsConverted % 1000) == 0 &&
      data.brlCentsCredited is number && data.brlCentsCredited == (data.pointsConverted / 100) &&
      isValidDateStr(data.conversionDate) &&
      data.captchaVerified == true &&
      data.integrityToken is string && data.integrityToken.size() >= 12 && data.integrityToken.size() <= 128 &&
      data.createdAt is timestamp;
    }

    function isValidWithdrawal(data) {
      return data.keys().hasAll([
        'withdrawalId', 'userId', 'userDisplayName', 'amountCents', 'pixKeyType',
        'pixKey', 'status', 'fraudCheckPassed', 'adminNote', 'pixTransactionId',
        'requestedDate', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'withdrawalId', 'userId', 'userDisplayName', 'amountCents', 'pixKeyType',
        'pixKey', 'status', 'fraudCheckPassed', 'adminNote', 'pixTransactionId',
        'requestedDate', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.withdrawalId) &&
      isValidId(data.userId) &&
      data.userDisplayName is string && data.userDisplayName.size() >= 1 && data.userDisplayName.size() <= 80 &&
      data.amountCents is number && data.amountCents >= 1 &&
      data.pixKeyType in ['cpf', 'email', 'phone', 'random'] &&
      data.pixKey is string && data.pixKey.size() >= 5 && data.pixKey.size() <= 140 &&
      data.status in ['pending', 'approved', 'paid', 'rejected'] &&
      data.fraudCheckPassed is bool &&
      data.adminNote is string && data.adminNote.size() <= 300 &&
      data.pixTransactionId is string && data.pixTransactionId.size() <= 120 &&
      isValidDateStr(data.requestedDate) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidFraudEvent(data) {
      return data.keys().hasAll([
        'logId', 'userId', 'eventType', 'severity', 'details', 'resolved', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'logId', 'userId', 'eventType', 'severity', 'details', 'resolved', 'createdAt'
      ]) &&
      isValidId(data.logId) &&
      isValidId(data.userId) &&
      data.eventType in [
        'speed_anomaly', 'score_cap_exceeded', 'double_conversion_attempt',
        'bot_challenge_failed', 'suspicious_withdrawal', 'manual_flag',
        'profanity_username_ban', 'admin_ban'
      ] &&
      data.severity in ['low', 'medium', 'high', 'critical'] &&
      data.details is string && data.details.size() >= 3 && data.details.size() <= 400 &&
      data.resolved is bool &&
      data.createdAt is timestamp;
    }

    function isValidEmailNotification(data) {
      return data.keys().hasAll([
        'notificationId', 'userId', 'recipientEmail', 'eventType',
        'subject', 'summary', 'deliveryStatus', 'referenceId', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'notificationId', 'userId', 'recipientEmail', 'eventType',
        'subject', 'summary', 'deliveryStatus', 'referenceId', 'createdAt'
      ]) &&
      isValidId(data.notificationId) &&
      isValidId(data.userId) &&
      data.recipientEmail is string && data.recipientEmail.size() >= 3 && data.recipientEmail.size() <= 160 &&
      data.eventType in ['conversion_confirmed', 'withdrawal_requested', 'withdrawal_approved', 'withdrawal_paid', 'withdrawal_rejected', 'streak_bonus_credited', 'invite_sent', 'referral_welcome', 'referral_bonus_credited'] &&
      data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 160 &&
      data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 500 &&
      data.deliveryStatus in ['sent_smtp', 'logged_in_app', 'failed'] &&
      data.referenceId is string && data.referenceId.size() <= 128 &&
      data.createdAt is timestamp;
    }

    function isValidIntegration(data) {
      return data.keys().hasAll([
        'integrationId', 'name', 'providerType', 'endpointUrl', 'apiKeyPrefix',
        'apiKeyHash', 'active', 'lastTriggeredAt', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'integrationId', 'name', 'providerType', 'endpointUrl', 'apiKeyPrefix',
        'apiKeyHash', 'active', 'lastTriggeredAt', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.integrationId) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.providerType in ['erp_webhook', 'accounting_api', 'pix_gateway', 'bi_export'] &&
      data.endpointUrl is string && data.endpointUrl.size() <= 300 &&
      data.apiKeyPrefix is string && data.apiKeyPrefix.size() <= 24 &&
      data.apiKeyHash is string && data.apiKeyHash.size() <= 128 &&
      data.active is bool &&
      data.lastTriggeredAt is string && data.lastTriggeredAt.size() <= 40 &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'photoURL', 'brlBalanceCents',
        'pointsBalance', 'gamesPlayed', 'status', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'photoURL', 'brlBalanceCents',
        'pointsBalance', 'lifetimePoints', 'gamesPlayed', 'status',
        'identityVerified', 'verifiedBadge', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
      isValidPhotoUrl(data.photoURL) &&
      data.brlBalanceCents is number && data.brlBalanceCents >= 0 &&
      data.pointsBalance is number && data.pointsBalance >= 0 &&
      (!('lifetimePoints' in data) || (data.lifetimePoints is number && data.lifetimePoints >= 0)) &&
      data.gamesPlayed is number && data.gamesPlayed >= 0 &&
      data.status in ['active', 'suspended', 'flagged'] &&
      (!('identityVerified' in data) || data.identityVerified is bool) &&
      (!('verifiedBadge' in data) || data.verifiedBadge in ['none', 'blue', 'owner']) &&
      data.updatedAt is timestamp;
    }

    function isValidDailyCheckin(data) {
      return data.keys().hasAll([
        'checkinId', 'userId', 'checkinDate', 'pointsAwarded',
        'weekTotalAfter', 'streakDay', 'brlBonusCents', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'checkinId', 'userId', 'checkinDate', 'pointsAwarded',
        'weekTotalAfter', 'streakDay', 'brlBonusCents', 'createdAt'
      ]) &&
      isValidId(data.checkinId) &&
      isValidId(data.userId) &&
      isValidDateStr(data.checkinDate) &&
      data.pointsAwarded is number && data.pointsAwarded >= 120 && data.pointsAwarded <= 200 &&
      data.weekTotalAfter is number && data.weekTotalAfter >= data.pointsAwarded && data.weekTotalAfter <= 1400 &&
      data.streakDay is number && data.streakDay >= 1 && data.streakDay <= 30 &&
      data.brlBonusCents is number && (
        (data.streakDay < 30 && data.brlBonusCents == 0) ||
        (data.streakDay == 30 && data.brlBonusCents == 1000)
      ) &&
      data.createdAt is timestamp;
    }

    function isValidLevelReward(data) {
      return data.keys().hasAll([
        'rewardId', 'userId', 'level', 'rewardPoints', 'xpAtClaim', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'rewardId', 'userId', 'level', 'rewardPoints', 'xpAtClaim', 'createdAt'
      ]) &&
      isValidId(data.rewardId) &&
      isValidId(data.userId) &&
      data.level in [2, 3, 4, 5, 6] &&
      data.rewardPoints is number && (
        (data.level == 2 && data.rewardPoints == 200) ||
        (data.level == 3 && data.rewardPoints == 400) ||
        (data.level == 4 && data.rewardPoints == 800) ||
        (data.level == 5 && data.rewardPoints == 1500) ||
        (data.level == 6 && data.rewardPoints == 3000)
      ) &&
      data.xpAtClaim is number && data.xpAtClaim >= 1000 &&
      data.createdAt is timestamp;
    }

    function isValidReferral(data) {
      return data.keys().hasAll([
        'referralId', 'referrerUid', 'invitedUid', 'invitedDisplayName',
        'signupBonusPoints', 'commissionRatePct', 'totalCommissionPointsEarned',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'referralId', 'referrerUid', 'invitedUid', 'invitedDisplayName',
        'signupBonusPoints', 'commissionRatePct', 'totalCommissionPointsEarned',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.referralId) &&
      isValidId(data.referrerUid) &&
      isValidId(data.invitedUid) &&
      data.invitedDisplayName is string && data.invitedDisplayName.size() >= 1 && data.invitedDisplayName.size() <= 80 &&
      data.signupBonusPoints == 500 &&
      data.commissionRatePct == 12 &&
      data.totalCommissionPointsEarned is number && data.totalCommissionPointsEarned >= 0 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPromoCode(data) {
      return data.keys().hasAll([
        'code', 'title', 'pointsValue', 'maxRedemptions', 'redemptionCount',
        'active', 'publicEvent', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'code', 'title', 'pointsValue', 'maxRedemptions', 'redemptionCount',
        'active', 'publicEvent', 'publishDelayMinutes', 'publishAt',
        'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      isValidPromoCodeId(data.code) &&
      data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
      data.pointsValue is number && data.pointsValue >= 10 && data.pointsValue <= 100000 &&
      data.maxRedemptions is number && data.maxRedemptions >= 1 && data.maxRedemptions <= 100000 &&
      data.redemptionCount is number && data.redemptionCount >= 0 && data.redemptionCount <= data.maxRedemptions &&
      data.active is bool &&
      data.publicEvent is bool &&
      (!('publishDelayMinutes' in data) || (data.publishDelayMinutes is number && data.publishDelayMinutes >= 0 && data.publishDelayMinutes <= 1440)) &&
      (!('publishAt' in data) || data.publishAt is timestamp) &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPromoRedemption(data) {
      return data.keys().hasAll([
        'redemptionId', 'code', 'userId', 'pointsAwarded', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'redemptionId', 'code', 'userId', 'pointsAwarded', 'createdAt'
      ]) &&
      isValidId(data.redemptionId) &&
      isValidPromoCodeId(data.code) &&
      isValidId(data.userId) &&
      data.pointsAwarded is number && data.pointsAwarded >= 10 && data.pointsAwarded <= 100000 &&
      data.createdAt is timestamp;
    }

    function isValidMailboxMessage(data) {
      return data.keys().hasAll([
        'messageId', 'title', 'body', 'category', 'promoCode',
        'pointsValue', 'publishAt', 'active', 'createdBy', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'messageId', 'title', 'body', 'category', 'promoCode',
        'pointsValue', 'publishAt', 'active', 'createdBy', 'createdAt'
      ]) &&
      isValidId(data.messageId) &&
      data.title is string && data.title.size() >= 3 && data.title.size() <= 140 &&
      data.body is string && data.body.size() >= 3 && data.body.size() <= 600 &&
      data.category in ['promo_event', 'system_notice'] &&
      data.promoCode is string && data.promoCode.size() <= 40 &&
      data.pointsValue is number && data.pointsValue >= 0 && data.pointsValue <= 100000 &&
      data.publishAt is timestamp &&
      data.active is bool &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp;
    }

    function isValidWithdrawalSettings(data) {
      return data.keys().hasAll([
        'settingId', 'firstWithdrawalMinCents', 'standardWithdrawalMinCents',
        'quickAmountsCents', 'updatedBy', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'settingId', 'firstWithdrawalMinCents', 'standardWithdrawalMinCents',
        'quickAmountsCents', 'updatedBy', 'updatedAt'
      ]) &&
      data.settingId == 'withdrawal' &&
      data.firstWithdrawalMinCents is number && data.firstWithdrawalMinCents >= 1 && data.firstWithdrawalMinCents <= 2000 &&
      data.standardWithdrawalMinCents is number && data.standardWithdrawalMinCents >= 1 && data.standardWithdrawalMinCents <= 2000 &&
      data.quickAmountsCents is list &&
      data.quickAmountsCents.size() >= 1 &&
      data.quickAmountsCents.size() <= 12 &&
      data.quickAmountsCents[0] is number &&
      data.quickAmountsCents[0] >= 1 &&
      data.quickAmountsCents[0] <= 2000 &&
      data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 160 &&
      data.updatedAt is timestamp;
    }

    function isValidWithdrawalAttemptLog(data) {
      return data.keys().hasAll([
        'attemptId', 'userId', 'userDisplayName', 'withdrawalId', 'amountCents',
        'pixKeyType', 'pixKey', 'status', 'details', 'deviceFingerprint',
        'actorUid', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'attemptId', 'userId', 'userDisplayName', 'withdrawalId', 'amountCents',
        'pixKeyType', 'pixKey', 'status', 'details', 'deviceFingerprint',
        'actorUid', 'createdAt'
      ]) &&
      isValidId(data.attemptId) &&
      isValidId(data.userId) &&
      data.userDisplayName is string && data.userDisplayName.size() >= 1 && data.userDisplayName.size() <= 80 &&
      data.withdrawalId is string && data.withdrawalId.size() <= 128 &&
      data.amountCents is number && data.amountCents >= 0 && data.amountCents <= 10000000 &&
      data.pixKeyType in ['none', 'cpf', 'email', 'phone', 'random'] &&
      data.pixKey is string && data.pixKey.size() <= 140 &&
      data.status in [
        'submitted_pending', 'approved', 'paid', 'rejected',
        'blocked_min_amount', 'blocked_insufficient_balance',
        'blocked_invalid_pix', 'blocked_captcha',
        'blocked_account_status', 'failed_transaction'
      ] &&
      data.details is string && data.details.size() >= 2 && data.details.size() <= 300 &&
      data.deviceFingerprint is string && data.deviceFingerprint.size() <= 128 &&
      isValidId(data.actorUid) &&
      data.createdAt is timestamp;
    }

    function sortedPairId(a, b) {
      return a < b ? a + '__' + b : b + '__' + a;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll([
        'senderUid', 'recipientUid', 'senderName', 'recipientName',
        'participantUids', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'senderUid', 'recipientUid', 'senderName', 'recipientName',
        'participantUids', 'status', 'createdAt', 'respondedAt'
      ]) &&
      isValidId(data.senderUid) &&
      isValidId(data.recipientUid) &&
      data.senderUid != data.recipientUid &&
      data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
      data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 80 &&
      data.participantUids is list && data.participantUids.size() == 2 &&
      data.senderUid in data.participantUids &&
      data.recipientUid in data.participantUids &&
      data.status in ['pending', 'accepted', 'rejected'] &&
      data.createdAt is timestamp &&
      (!('respondedAt' in data) || data.respondedAt == null || data.respondedAt is timestamp);
    }

    function isValidFriendship(data) {
      return data.keys().hasAll(['memberUids', 'createdAt']) &&
      data.keys().hasOnly(['memberUids', 'createdAt']) &&
      data.memberUids is list &&
      data.memberUids.size() == 2 &&
      isValidId(data.memberUids[0]) &&
      isValidId(data.memberUids[1]) &&
      data.memberUids[0] != data.memberUids[1] &&
      data.createdAt is timestamp;
    }

    function isValidSocialMessage(data) {
      return data.keys().hasAll(['senderUid', 'senderName', 'text', 'createdAt']) &&
      data.keys().hasOnly([
        'senderUid', 'senderName', 'text', 'messageType', 'mediaDataUrl',
        'audioDurationSec', 'readAt', 'readBy', 'createdAt'
      ]) &&
      isValidId(data.senderUid) &&
      data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
      (!('messageType' in data) || data.messageType in ['text', 'image', 'audio']) &&
      (!('mediaDataUrl' in data) || isValidPrivateMediaDataUrl(data.mediaDataUrl)) &&
      (!('audioDurationSec' in data) || (data.audioDurationSec is number && data.audioDurationSec >= 0 && data.audioDurationSec <= 60)) &&
      (!('readAt' in data) || data.readAt == null || data.readAt is timestamp) &&
      (!('readBy' in data) || isValidId(data.readBy)) &&
      data.createdAt is timestamp;
    }

    function isValidMultiplayerMatch(data) {
      return data.keys().hasAll([
        'matchId', 'roomCode', 'gameId', 'participantUids',
        'winnerUid', 'loserUid', 'stakePoints', 'settledByUid',
        'integrityHash', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'matchId', 'roomCode', 'gameId', 'participantUids',
        'winnerUid', 'loserUid', 'stakePoints', 'settledByUid',
        'integrityHash', 'createdAt'
      ]) &&
      isValidId(data.matchId) &&
      data.roomCode is string && data.roomCode.size() >= 3 && data.roomCode.size() <= 20 &&
      data.gameId in [
        'domino', 'stop', 'draw_guess', 'battleship', 'connect4',
        'quiz', 'rps', 'tictactoe_mp', 'guess_number', 'memory_mp', 'reflex_mp'
      ] &&
      data.participantUids is list &&
      data.participantUids.size() == 2 &&
      isValidId(data.participantUids[0]) &&
      isValidId(data.participantUids[1]) &&
      data.participantUids[0] != data.participantUids[1] &&
      data.winnerUid is string && data.winnerUid.size() <= 128 &&
      data.loserUid is string && data.loserUid.size() <= 128 &&
      data.stakePoints is number && data.stakePoints >= 0 && data.stakePoints <= 50000 &&
      isValidId(data.settledByUid) &&
      data.integrityHash is string && data.integrityHash.size() >= 16 && data.integrityHash.size() <= 128 &&
      data.createdAt is timestamp;
    }

    function validatePvpMatchUserUpdate(userId, existingUser, incomingUser, m) {
      return m.stakePoints > 0 &&
        userId in m.participantUids &&
        request.auth.uid in m.participantUids &&
        m.winnerUid != '' &&
        m.loserUid != '' &&
        m.winnerUid != m.loserUid && (
          (
            userId == m.winnerUid &&
            incomingUser.diff(existingUser).affectedKeys().hasOnly([
              'pointsBalance', 'lifetimePoints', 'gamesPlayed', 'lastMpMatchId', 'updatedAt'
            ]) &&
            (incomingUser.pointsBalance - existingUser.pointsBalance) == m.stakePoints &&
            incomingUser.lifetimePoints == existingUser.lifetimePoints + m.stakePoints &&
            incomingUser.gamesPlayed == existingUser.gamesPlayed + 1 &&
            getAfter(/databases/$(database)/documents/users/$(m.loserUid)).data.lastMpMatchId == incomingUser.lastMpMatchId
          ) || (
            userId == m.loserUid &&
            incomingUser.diff(existingUser).affectedKeys().hasOnly([
              'pointsBalance', 'gamesPlayed', 'lastMpMatchId', 'updatedAt'
            ]) &&
            (existingUser.pointsBalance - incomingUser.pointsBalance) == m.stakePoints &&
            incomingUser.pointsBalance >= 0 &&
            incomingUser.gamesPlayed == existingUser.gamesPlayed + 1 &&
            getAfter(/databases/$(database)/documents/users/$(m.winnerUid)).data.lastMpMatchId == incomingUser.lastMpMatchId
          )
        );
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll([
        'ticketId', 'userId', 'userDisplayName', 'topic', 'subject',
        'bielSummary', 'status', 'assignedAdminUid', 'assignedAdminName',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ticketId', 'userId', 'userDisplayName', 'topic', 'subject',
        'bielSummary', 'status', 'assignedAdminUid', 'assignedAdminName',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.ticketId) &&
      isValidId(data.userId) &&
      data.userDisplayName is string && data.userDisplayName.size() >= 1 && data.userDisplayName.size() <= 80 &&
      data.topic in ['checkin', 'pix', 'invites', 'games', 'account', 'other'] &&
      data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 140 &&
      data.bielSummary is string && data.bielSummary.size() >= 3 && data.bielSummary.size() <= 800 &&
      data.status in ['waiting_human', 'active_human', 'closed'] &&
      data.assignedAdminUid is string && data.assignedAdminUid.size() <= 128 &&
      data.assignedAdminName is string && data.assignedAdminName.size() <= 80 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSupportMessage(data) {
      return data.keys().hasAll([
        'messageId', 'ticketId', 'senderUid', 'senderName',
        'senderRole', 'text', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'messageId', 'ticketId', 'senderUid', 'senderName',
        'senderRole', 'text', 'createdAt'
      ]) &&
      isValidId(data.messageId) &&
      isValidId(data.ticketId) &&
      isValidId(data.senderUid) &&
      data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
      data.senderRole in ['user', 'biel', 'admin'] &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 800 &&
      data.createdAt is timestamp;
    }

    function isValidMaintenanceSettings(data) {
      return data.keys().hasAll([
        'settingId', 'enabled', 'title', 'message', 'estimatedReturn', 'updatedBy', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'settingId', 'enabled', 'title', 'message', 'estimatedReturn', 'updatedBy', 'updatedAt'
      ]) &&
      data.settingId == 'maintenance' &&
      data.enabled is bool &&
      data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
      data.message is string && data.message.size() >= 3 && data.message.size() <= 500 &&
      data.estimatedReturn is string && data.estimatedReturn.size() <= 120 &&
      data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 160 &&
      data.updatedAt is timestamp;
    }

    function isValidDeletedMailboxEntry(data) {
      return data.keys().hasAll(['messageId', 'deletedAt']) &&
      data.keys().hasOnly(['messageId', 'deletedAt']) &&
      isValidId(data.messageId) &&
      data.deletedAt is timestamp;
    }

    function isValidFaceVerification(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'selfieDataUrl', 'status',
        'rejectionReason', 'bonusAwarded', 'reviewedBy', 'submittedAt', 'reviewedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'birthDate', 'selfieDataUrl', 'status',
        'rejectionReason', 'bonusAwarded', 'reviewedBy', 'submittedAt', 'reviewedAt'
      ]) &&
      isValidId(data.uid) &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
      (!('birthDate' in data) || isValidDateStr(data.birthDate)) &&
      isValidSelfieDataUrl(data.selfieDataUrl) &&
      data.status in ['pending', 'approved', 'rejected'] &&
      data.rejectionReason is string && data.rejectionReason.size() <= 240 &&
      data.bonusAwarded is bool &&
      data.reviewedBy is string && data.reviewedBy.size() <= 160 &&
      data.submittedAt is timestamp &&
      (data.reviewedAt == null || data.reviewedAt is timestamp);
    }

    function isValidVerificationRequest(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'fullName', 'cpf', 'birthDate',
        'documentType', 'documentNumber', 'status',
        'rejectionReason', 'reviewedBy', 'submittedAt', 'reviewedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'fullName', 'cpf', 'birthDate',
        'documentType', 'documentNumber', 'status',
        'rejectionReason', 'reviewedBy', 'submittedAt', 'reviewedAt'
      ]) &&
      isValidId(data.uid) &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
      data.fullName is string && data.fullName.size() >= 5 && data.fullName.size() <= 120 &&
      data.cpf is string && data.cpf.matches('^[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}$') &&
      isValidDateStr(data.birthDate) &&
      data.documentType in ['rg', 'cnh', 'passaporte', 'outro'] &&
      data.documentNumber is string && data.documentNumber.size() >= 4 && data.documentNumber.size() <= 32 &&
      data.status in ['pending', 'approved', 'rejected'] &&
      data.rejectionReason is string && data.rejectionReason.size() <= 240 &&
      data.reviewedBy is string && data.reviewedBy.size() <= 160 &&
      data.submittedAt is timestamp &&
      (data.reviewedAt == null || data.reviewedAt is timestamp);
    }

    function isValidCasinoSession(data) {
      return data.keys().hasAll([
        'sessionId', 'userId', 'gameType', 'currency', 'stakeAmount',
        'payoutAmount', 'multiplier', 'status', 'details',
        'integrityHash', 'createdAt', 'settledAt'
      ]) &&
      data.keys().hasOnly([
        'sessionId', 'userId', 'gameType', 'currency', 'stakeAmount',
        'payoutAmount', 'multiplier', 'status', 'details',
        'integrityHash', 'createdAt', 'settledAt'
      ]) &&
      isValidId(data.sessionId) &&
      isValidId(data.userId) &&
      data.gameType in ['double', 'mines'] &&
      data.currency in ['points', 'brl'] &&
      data.stakeAmount is number && (
        (data.currency == 'points' && data.stakeAmount >= 10 && data.stakeAmount <= 10000) ||
        (data.currency == 'brl' && data.stakeAmount >= 1 && data.stakeAmount <= 5000)
      ) &&
      data.payoutAmount is number && data.payoutAmount >= 0 && data.payoutAmount <= (data.stakeAmount * 50) &&
      data.multiplier is number && data.multiplier >= 0 && data.multiplier <= 50 &&
      data.status in ['active', 'won', 'lost'] &&
      data.details is string && data.details.size() <= 200 &&
      data.integrityHash is string && data.integrityHash.size() >= 16 && data.integrityHash.size() <= 128 &&
      data.createdAt is timestamp &&
      (data.settledAt == null || data.settledAt is timestamp);
    }

    function validateCasinoCreateUserUpdate(userId, existingUser, incomingUser) {
      return ('lastCasinoSessionId' in incomingUser) &&
        isValidId(incomingUser.lastCasinoSessionId) &&
        (!('lastCasinoSessionId' in existingUser) || incomingUser.lastCasinoSessionId != existingUser.lastCasinoSessionId) &&
        !exists(/databases/$(database)/documents/casinoSessions/$(incomingUser.lastCasinoSessionId)) &&
        existsAfter(/databases/$(database)/documents/casinoSessions/$(incomingUser.lastCasinoSessionId)) &&
        validateCasinoStartOrRollPair(
          userId,
          existingUser,
          incomingUser,
          getAfter(/databases/$(database)/documents/casinoSessions/$(incomingUser.lastCasinoSessionId)).data
        );
    }

    function validateCasinoStartOrRollPair(userId, existingUser, incomingUser, s) {
      return s.userId == userId && (
        (
          s.currency == 'points' &&
          incomingUser.diff(existingUser).affectedKeys().hasOnly(['pointsBalance', 'lastCasinoSessionId', 'updatedAt']) &&
          incomingUser.pointsBalance is number &&
          incomingUser.pointsBalance >= 0 &&
          incomingUser.pointsBalance == (('pointsBalance' in existingUser && existingUser.pointsBalance is number) ? existingUser.pointsBalance : 0) - s.stakeAmount + s.payoutAmount
        ) || (
          s.currency == 'brl' &&
          incomingUser.diff(existingUser).affectedKeys().hasOnly(['brlBalanceCents', 'lastCasinoSessionId', 'updatedAt']) &&
          incomingUser.brlBalanceCents is number &&
          incomingUser.brlBalanceCents >= 0 &&
          incomingUser.brlBalanceCents == (('brlBalanceCents' in existingUser && existingUser.brlBalanceCents is number) ? existingUser.brlBalanceCents : 0) - s.stakeAmount + s.payoutAmount
        )
      );
    }

    function validateCasinoMinesSettleUserUpdate(userId, existingUser, incomingUser) {
      return ('lastCasinoSessionId' in existingUser) &&
        isValidId(existingUser.lastCasinoSessionId) &&
        exists(/databases/$(database)/documents/casinoSessions/$(existingUser.lastCasinoSessionId)) &&
        validateCasinoMinesSettlePair(
          userId,
          existingUser,
          incomingUser,
          get(/databases/$(database)/documents/casinoSessions/$(existingUser.lastCasinoSessionId)).data,
          getAfter(/databases/$(database)/documents/casinoSessions/$(existingUser.lastCasinoSessionId)).data
        );
    }

    function validateCasinoMinesSettlePair(userId, existingUser, incomingUser, sBefore, sAfter) {
      return sBefore.userId == userId &&
        sBefore.gameType == 'mines' &&
        sBefore.status == 'active' &&
        sAfter.status == 'won' &&
        sAfter.payoutAmount > 0 && (
          (
            sBefore.currency == 'points' &&
            incomingUser.diff(existingUser).affectedKeys().hasOnly(['pointsBalance', 'updatedAt']) &&
            incomingUser.pointsBalance is number &&
            incomingUser.pointsBalance == (('pointsBalance' in existingUser && existingUser.pointsBalance is number) ? existingUser.pointsBalance : 0) + sAfter.payoutAmount
          ) || (
            sBefore.currency == 'brl' &&
            incomingUser.diff(existingUser).affectedKeys().hasOnly(['brlBalanceCents', 'updatedAt']) &&
            incomingUser.brlBalanceCents is number &&
            incomingUser.brlBalanceCents == (('brlBalanceCents' in existingUser && existingUser.brlBalanceCents is number) ? existingUser.brlBalanceCents : 0) + sAfter.payoutAmount
          )
        );
    }

    // --- Collection Rules ---

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == userId &&
        incoming().pointsBalance == 0 &&
        incoming().lifetimePoints == 0 &&
        incoming().brlBalanceCents == 0 &&
        incoming().totalWithdrawnCents == 0 &&
        incoming().lastConversionDate == '' &&
        incoming().gamesPlayed == 0 &&
        !('banReason' in incoming()) &&
        !('banExplanation' in incoming()) &&
        !('bannedBy' in incoming()) &&
        !('lastPromoCode' in incoming()) &&
        !('firstWithdrawalUsed' in incoming()) &&
        !('lastMpMatchId' in incoming()) &&
        !('lastCasinoSessionId' in incoming()) &&
        (!('identityVerified' in incoming()) || incoming().identityVerified == false) &&
        (!('verifiedBadge' in incoming()) || incoming().verifiedBadge == 'none') &&
        (!('verificationStatus' in incoming()) || incoming().verificationStatus == 'none') &&
        (!('verificationNote' in incoming()) || incoming().verificationNote == '') &&
        (!('faceVerificationStatus' in incoming()) || incoming().faceVerificationStatus == 'none') &&
        !('faceVerificationNote' in incoming()) &&
        (!('verifiedAt' in incoming()) || incoming().verifiedAt == null) &&
        (
          (!('ageVerified' in incoming()) || incoming().ageVerified == false) ||
          (
            incoming().ageVerified == true &&
            ('birthDate' in incoming()) &&
            isValidDateStr(incoming().birthDate) &&
            incoming().ageVerifiedAt == request.time
          )
        ) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (incoming().status == 'active' && incoming().riskScore == 0) ||
          (incoming().status == 'suspended' && incoming().riskScore == 100)
        );

      allow update: if isValidId(userId) &&
        isSignedIn() &&
        isValidUserAccount(incoming()) &&
        (!('uid' in existing()) || incoming().uid == existing().uid) &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time && (
          isPlatformOwner() || (
            isAdmin() &&
            !isProtectedOwnerAccount(userId) &&
            (!('verifiedBadge' in incoming()) || incoming().verifiedBadge != 'owner')
          ) || (
            isOwner(userId) &&
            isActiveUser(userId) &&
            ('status' in existing()) &&
            ('riskScore' in existing()) &&
            (!('totalWithdrawnCents' in existing()) || incoming().totalWithdrawnCents == existing().totalWithdrawnCents) && (
              // Action A: Profile Update (active status preserved)
              (
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore &&
                incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
              ) ||
              // Action B: Game Score Credit (bounded <= 500 pts per match)
              (
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore &&
                incoming().diff(existing()).affectedKeys().hasOnly(['pointsBalance', 'lifetimePoints', 'gamesPlayed', 'updatedAt']) &&
                incoming().pointsBalance >= existing().pointsBalance &&
                incoming().pointsBalance <= existing().pointsBalance + 500 &&
                incoming().lifetimePoints == existing().lifetimePoints + (incoming().pointsBalance - existing().pointsBalance) &&
                incoming().gamesPlayed == existing().gamesPlayed + 1
              ) ||
              // Action C: Once-Per-Day Conversion locked to server UTC date (1000 pts = 10 BRL cents)
              (
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore &&
                incoming().diff(existing()).affectedKeys().hasOnly(['pointsBalance', 'brlBalanceCents', 'lastConversionDate', 'updatedAt']) &&
                incoming().lastConversionDate == serverDateStr() &&
                incoming().lastConversionDate != existing().lastConversionDate &&
                incoming().pointsBalance < existing().pointsBalance &&
                (existing().pointsBalance - incoming().pointsBalance) >= 1000 &&
                ((existing().pointsBalance - incoming().pointsBalance) % 1000) == 0 &&
                incoming().brlBalanceCents == existing().brlBalanceCents + ((existing().pointsBalance - incoming().pointsBalance) / 100)
              ) ||
              // Action D: Pix Withdrawal Deduction (1st withdrawal default 10 cents; configurable 1..2000 cents via admin)
              (
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore &&
                incoming().diff(existing()).affectedKeys().hasOnly(['brlBalanceCents', 'firstWithdrawalUsed', 'updatedAt']) &&
                incoming().firstWithdrawalUsed == true &&
                incoming().brlBalanceCents < existing().brlBalanceCents &&
                (existing().brlBalanceCents - incoming().brlBalanceCents) >= requiredWithdrawalMinCents(existing())
              ) ||
              // Action E: Daily Random Check-in (120–200 pts once per UTC day + R$10 / 1000 cents at 30-day streak)
              (
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore &&
                incoming().diff(existing()).affectedKeys().hasOnly(['pointsBalance', 'lifetimePoints', 'brlBalanceCents', 'updatedAt']) &&
                (incoming().pointsBalance - existing().pointsBalance) >= 120 &&
                (incoming().pointsBalance - existing().pointsBalance) <= 200 &&
                incoming().lifetimePoints == existing().lifetimePoints + (incoming().pointsBalance - existing().pointsBalance) &&
                !exists(/databases/$(database)/documents/dailyCheckins/$(checkinDocId(userId))) &&
                existsAfter(/databases/$(database)/documents/dailyCheckins/$(checkinDocId(userId))) &&
                validateUserCheckinAction(
                  getAfter(/databases/$(database)/documents/dailyCheckins/$(checkinDocId(userId))).data,
                  incoming().pointsBalance - existing().pointsBalance,
                  incoming().brlBalanceCents - existing().brlBalanceCents
                )
              ) ||
              // Action F: Immediate Self-Suspension on Anti-Profanity Violation
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'riskScore', 'updatedAt']) &&
                incoming().status == 'suspended' &&
                incoming().riskScore == 100
              ) ||
              // Action G: One-Time Level-Up Reward Claim (levels 2..6 verified via XP + atomic levelRewards doc)
              (
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore &&
                incoming().diff(existing()).affectedKeys().hasOnly(['pointsBalance', 'updatedAt']) &&
                (
                  (
                    (incoming().pointsBalance - existing().pointsBalance) == 200 &&
                    userXp(existing()) >= 1000 &&
                    !exists(/databases/$(database)/documents/levelRewards/$(levelRewardDocId(userId, 2))) &&
                    existsAfter(/databases/$(database)/documents/levelRewards/$(levelRewardDocId(userId, 2)))
                  ) ||
                  (
                    (incoming().pointsBalance - existing().pointsBalance) == 400 &&
                    userXp(existing()) >= 3000 &&
                    !exists(/databases/$(database)/documents/levelRewards/$(levelRewardDocId(userId, 3))) &&
                    existsAfter(/databases/$(database)/documents/levelRewards/$(levelRewardDocId(userId, 3)))
                  ) ||
                  (
                    (incoming().pointsBalance - existing().pointsBalance) == 800 &&
                    userXp(existing()) >= 7000 &&
                    !exists(/databases/$(database)/documents/levelRewards/$(levelRewardDocId(userId, 4))) &&
                    existsAfter(/databases/$(database)/documents/levelRewards/$(levelRewardDocId(userId, 4)))
                  ) ||
                  (
                    (incoming().pointsBalance - existing().pointsBalance) == 1500 &&
                    userXp(existing()) >= 15000 &&
                    !exists(/databases/$(database)/documents/levelRewards/$(levelRewardDocId(userId, 5))) &&
                    existsAfter(/databases/$(database)/documents/levelRewards/$(levelRewardDocId(userId, 5)))
                  ) ||
                  (
                    (incoming().pointsBalance - existing().pointsBalance) == 3000 &&
                    userXp(existing()) >= 30000 &&
                    !exists(/databases/$(database)/documents/levelRewards/$(levelRewardDocId(userId, 6))) &&
                    existsAfter(/databases/$(database)/documents/levelRewards/$(levelRewardDocId(userId, 6)))
                  )
                )
              ) ||
              // Action J: One-Time Admin Promo Code Redemption (respecting publishAt)
              (
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore &&
                incoming().diff(existing()).affectedKeys().hasOnly(['pointsBalance', 'lastPromoCode', 'updatedAt']) &&
                ('lastPromoCode' in incoming()) &&
                isValidPromoCodeId(incoming().lastPromoCode) &&
                !exists(/databases/$(database)/documents/promoRedemptions/$(promoRedemptionDocId(userId, incoming().lastPromoCode))) &&
                existsAfter(/databases/$(database)/documents/promoRedemptions/$(promoRedemptionDocId(userId, incoming().lastPromoCode))) &&
                exists(/databases/$(database)/documents/promoCodes/$(incoming().lastPromoCode)) &&
                validateUserPromoAction(
                  get(/databases/$(database)/documents/promoCodes/$(incoming().lastPromoCode)).data,
                  getAfter(/databases/$(database)/documents/promoRedemptions/$(promoRedemptionDocId(userId, incoming().lastPromoCode))).data,
                  incoming().pointsBalance - existing().pointsBalance
                )
              ) ||
              // Action L: Mandatory +18 Age Verification
              (
                (!('ageVerified' in existing()) || existing().ageVerified != true) &&
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore &&
                incoming().diff(existing()).affectedKeys().hasOnly(['birthDate', 'ageVerified', 'ageVerifiedAt', 'updatedAt']) &&
                isValidDateStr(incoming().birthDate) &&
                incoming().ageVerified == true &&
                incoming().ageVerifiedAt == request.time
              ) ||
              // Action M: Facial Identity Verification Submission (synced atomically with /faceVerifications/{uid})
              (
                (!('identityVerified' in existing()) || existing().identityVerified != true) &&
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore &&
                incoming().diff(existing()).affectedKeys().hasOnly(['faceVerificationStatus', 'faceVerificationNote', 'updatedAt']) &&
                incoming().faceVerificationStatus == 'pending' &&
                incoming().faceVerificationNote == '' &&
                existsAfter(/databases/$(database)/documents/faceVerifications/$(userId)) &&
                getAfter(/databases/$(database)/documents/faceVerifications/$(userId)).data.status == 'pending' &&
                getAfter(/databases/$(database)/documents/faceVerifications/$(userId)).data.bonusAwarded == false
              ) ||
              // Action M2: Blue Verified Badge Request Submission (synced atomically with /verificationRequests/{uid})
              (
                (!('identityVerified' in existing()) || existing().identityVerified != true) &&
                (!('verifiedBadge' in existing()) || existing().verifiedBadge == null || existing().verifiedBadge == 'none') &&
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore &&
                incoming().diff(existing()).affectedKeys().hasOnly(['verificationStatus', 'verificationNote', 'updatedAt']) &&
                incoming().verificationStatus == 'pending' &&
                incoming().verificationNote == '' &&
                existsAfter(/databases/$(database)/documents/verificationRequests/$(userId)) &&
                getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data.status == 'pending'
              ) ||
              // Action N: In-App Casino Round / Session (Double spin, Mines deal & Mines cashout)
              (
                incoming().status == existing().status &&
                incoming().riskScore == existing().riskScore && (
                  validateCasinoCreateUserUpdate(userId, existing(), incoming()) ||
                  validateCasinoMinesSettleUserUpdate(userId, existing(), incoming())
                )
              )
            )
          ) || (
            // Cross-User Atomic Referral Credits to Referrer Account
            request.auth.uid != userId &&
            isActiveUser(userId) &&
            incoming().status == existing().status &&
            incoming().riskScore == existing().riskScore &&
            incoming().totalWithdrawnCents == existing().totalWithdrawnCents &&
            incoming().diff(existing()).affectedKeys().hasOnly(['pointsBalance', 'updatedAt']) && (
              // Action H: +500 points immediate referral signup bonus
              (
                (incoming().pointsBalance - existing().pointsBalance) == 500 &&
                !exists(/databases/$(database)/documents/referrals/$(request.auth.uid)) &&
                existsAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)) &&
                getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.referrerUid == userId &&
                getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.invitedUid == request.auth.uid &&
                getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.signupBonusPoints == 500
              ) ||
              // Action I: 12% ongoing commission on invited user's verified earnings
              isValidReferralCommission(
                incoming().pointsBalance - existing().pointsBalance,
                userId,
                request.auth.uid
              )
            )
          ) || (
            // Permit the account owner to restore access after a temporary suspension expires.
            isOwner(userId) &&
            existing().status == 'suspended' &&
            ('suspensionUntil' in existing()) &&
            existing().suspensionUntil is timestamp &&
            existing().suspensionUntil <= request.time &&
            incoming().status == 'active' &&
            incoming().riskScore == 0 &&
            incoming().suspensionUntil == null &&
            incoming().banReason == '' &&
            incoming().banExplanation == '' &&
            incoming().bannedBy == '' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'riskScore', 'suspensionUntil', 'banReason',
              'banExplanation', 'bannedBy', 'updatedAt'
            ])
          ) || (
            // Action K: Atomic PvP Wager Settlement (winner receives stake, loser pays stake, never negative)
            existing().status == 'active' &&
            incoming().status == existing().status &&
            incoming().riskScore == existing().riskScore &&
            incoming().totalWithdrawnCents == existing().totalWithdrawnCents &&
            ('lastMpMatchId' in incoming()) &&
            isValidId(incoming().lastMpMatchId) &&
            (!('lastMpMatchId' in existing()) || incoming().lastMpMatchId != existing().lastMpMatchId) &&
            !exists(/databases/$(database)/documents/multiplayerMatches/$(incoming().lastMpMatchId)) &&
            existsAfter(/databases/$(database)/documents/multiplayerMatches/$(incoming().lastMpMatchId)) &&
            validatePvpMatchUserUpdate(
              userId,
              existing(),
              incoming(),
              getAfter(/databases/$(database)/documents/multiplayerMatches/$(incoming().lastMpMatchId)).data
            )
          )
        );

      // Fallback restrito para contas legadas: permite concluir perfil, etapa +18,
      // check-in diário ou envio de selfie facial mesmo se o documento antigo
      // não possuir todos os campos opcionais/novos do schema completo.
      allow update: if isValidId(userId) &&
        isSignedIn() &&
        isOwner(userId) &&
        incoming().updatedAt == request.time && (
          // Fallback A: Atualização de Perfil e Avatar
          (
            isActiveUser(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'updatedAt'
            ]) &&
            incoming().displayName is string &&
            incoming().displayName.size() >= 1 &&
            incoming().displayName.size() <= 80 &&
            isValidPhotoUrl(incoming().photoURL)
          ) ||
          // Fallback L: Verificação Obrigatória de Idade (+18)
          (
            isActiveUser(userId) &&
            (!('ageVerified' in existing()) || existing().ageVerified != true) &&
            incoming().birthDate is string &&
            isValidDateStr(incoming().birthDate) &&
            incoming().ageVerified == true &&
            incoming().ageVerifiedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'birthDate', 'ageVerified', 'ageVerifiedAt', 'updatedAt'
            ])
          ) ||
          // Fallback E: Check-in Diário (atômico com dailyCheckins/{chkId})
          (
            isActiveUser(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'pointsBalance', 'lifetimePoints', 'brlBalanceCents', 'updatedAt'
            ]) &&
            incoming().pointsBalance is number &&
            incoming().lifetimePoints is number &&
            incoming().brlBalanceCents is number &&
            (incoming().pointsBalance - (('pointsBalance' in existing() && existing().pointsBalance is number) ? existing().pointsBalance : 0)) >= 120 &&
            (incoming().pointsBalance - (('pointsBalance' in existing() && existing().pointsBalance is number) ? existing().pointsBalance : 0)) <= 200 &&
            incoming().lifetimePoints == (('lifetimePoints' in existing() && existing().lifetimePoints is number) ? existing().lifetimePoints : 0) + (incoming().pointsBalance - (('pointsBalance' in existing() && existing().pointsBalance is number) ? existing().pointsBalance : 0)) &&
            !exists(/databases/$(database)/documents/dailyCheckins/$(checkinDocId(userId))) &&
            existsAfter(/databases/$(database)/documents/dailyCheckins/$(checkinDocId(userId))) &&
            validateUserCheckinAction(
              getAfter(/databases/$(database)/documents/dailyCheckins/$(checkinDocId(userId))).data,
              incoming().pointsBalance - (('pointsBalance' in existing() && existing().pointsBalance is number) ? existing().pointsBalance : 0),
              incoming().brlBalanceCents - (('brlBalanceCents' in existing() && existing().brlBalanceCents is number) ? existing().brlBalanceCents : 0)
            )
          ) ||
          // Fallback F: Auto-suspensão imediata por violação de palavrão no nome
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'riskScore', 'updatedAt'
            ]) &&
            incoming().status == 'suspended' &&
            incoming().riskScore == 100
          ) ||
          // Fallback M: Verificação Facial (atômico com faceVerifications/{userId})
          (
            (!('status' in existing()) || existing().status == null || existing().status == 'active') &&
            (!('identityVerified' in existing()) || existing().identityVerified != true) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'faceVerificationStatus', 'faceVerificationNote', 'updatedAt'
            ]) &&
            incoming().faceVerificationStatus == 'pending' &&
            incoming().faceVerificationNote == '' &&
            existsAfter(/databases/$(database)/documents/faceVerifications/$(userId)) &&
            getAfter(/databases/$(database)/documents/faceVerifications/$(userId)).data.status == 'pending' &&
            getAfter(/databases/$(database)/documents/faceVerifications/$(userId)).data.bonusAwarded == false
          ) ||
          // Fallback M2: Verificado Azul (atômico com verificationRequests/{userId})
          (
            (!('status' in existing()) || existing().status == null || existing().status == 'active') &&
            (!('identityVerified' in existing()) || existing().identityVerified != true) &&
            (!('verifiedBadge' in existing()) || existing().verifiedBadge == null || existing().verifiedBadge == 'none') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'verificationStatus', 'verificationNote', 'updatedAt'
            ]) &&
            incoming().verificationStatus == 'pending' &&
            incoming().verificationNote == '' &&
            existsAfter(/databases/$(database)/documents/verificationRequests/$(userId)) &&
            getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data.status == 'pending'
          ) ||
          // Fallback B: Pontuação em Jogos Solo para contas legadas
          (
            isActiveUser(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'pointsBalance', 'lifetimePoints', 'gamesPlayed', 'updatedAt'
            ]) &&
            incoming().pointsBalance is number &&
            incoming().lifetimePoints is number &&
            incoming().gamesPlayed is number &&
            incoming().pointsBalance >= (('pointsBalance' in existing() && existing().pointsBalance is number) ? existing().pointsBalance : 0) &&
            incoming().pointsBalance <= (('pointsBalance' in existing() && existing().pointsBalance is number) ? existing().pointsBalance : 0) + 500 &&
            incoming().lifetimePoints == (('lifetimePoints' in existing() && existing().lifetimePoints is number) ? existing().lifetimePoints : 0) + (incoming().pointsBalance - (('pointsBalance' in existing() && existing().pointsBalance is number) ? existing().pointsBalance : 0)) &&
            incoming().gamesPlayed == (('gamesPlayed' in existing() && existing().gamesPlayed is number) ? existing().gamesPlayed : 0) + 1
          ) ||
          // Fallback N: Cassino Double / Mines para contas legadas ou suspensões já expiradas
          (
            isActiveUser(userId) && (
              validateCasinoCreateUserUpdate(userId, existing(), incoming()) ||
              validateCasinoMinesSettleUserUpdate(userId, existing(), incoming())
            )
          )
        );

      // Fallback administrativo para aprovar/gerenciar contas legadas (Admin comum bloqueado de tocar no Dono)
      allow update: if isValidId(userId) && (
        isPlatformOwner() || (
          isAdmin() &&
          !isProtectedOwnerAccount(userId) &&
          (!('verifiedBadge' in incoming()) || incoming().verifiedBadge != 'owner')
        )
      ) &&
        (!('uid' in existing()) || incoming().uid == existing().uid) &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'pointsBalance', 'lifetimePoints',
          'brlBalanceCents', 'totalWithdrawnCents', 'lastConversionDate',
          'status', 'riskScore', 'gamesPlayed', 'banReason', 'banExplanation',
          'bannedBy', 'suspensionUntil', 'lastPromoCode', 'firstWithdrawalUsed',
          'lastMpMatchId', 'lastCasinoSessionId', 'birthDate', 'ageVerified', 'ageVerifiedAt',
          'identityVerified', 'verifiedBadge', 'verificationStatus', 'verificationNote',
          'faceVerificationStatus', 'faceVerificationNote', 'verifiedAt', 'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isPlatformOwner() && !isProtectedOwnerAccount(userId);

      // Isolated PII Subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin();
        allow create: if isValidId(userId) && isValidId(docId) &&
          docId == 'info' &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == userId &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) &&
          docId == 'info' &&
          isSignedIn() &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time && (
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'defaultPixKeyType', 'defaultPixKey', 'deviceFingerprint', 'updatedAt'
              ])
            ) ||
            isPlatformOwner() ||
            (isAdmin() && !isProtectedOwnerAccount(userId))
          );
        allow delete: if isValidId(userId) && isValidId(docId) && isPlatformOwner() && !isProtectedOwnerAccount(userId);
      }

      // Per-user deleted/dismissed Caixa de Correio message markers
      match /deletedMailbox/{messageId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId) &&
          isValidId(messageId) &&
          isOwner(userId) &&
          isValidDeletedMailboxEntry(incoming()) &&
          incoming().messageId == messageId &&
          incoming().deletedAt == request.time;
        allow delete: if isValidId(userId) && isValidId(messageId) && (isOwner(userId) || isAdmin());
      }
    }

    // 2. Admins Registry (Strict Owner-Only Management: regular admins cannot promote, modify, or revoke anyone)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) &&
        isPlatformOwner() &&
        isValidAdminRole(incoming()) &&
        incoming().uid == userId &&
        userId != 'H93H113NSHg0K3ircdUTe7fY0Gt1';
      allow delete: if isValidId(userId) &&
        isPlatformOwner() &&
        userId != 'H93H113NSHg0K3ircdUTe7fY0Gt1';
    }

    // 3. Game Sessions
    match /gameSessions/{sessionId} {
      allow get: if isValidId(sessionId) && (isAdmin() || (isSignedIn() && (resource == null || existing().userId == request.auth.uid)));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(sessionId) &&
        isSignedIn() &&
        isValidGameSession(incoming()) &&
        incoming().sessionId == sessionId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        isActiveUser(request.auth.uid);
      allow update: if isValidId(sessionId) &&
        isAdmin() &&
        isValidGameSession(incoming()) &&
        incoming().sessionId == existing().sessionId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(sessionId) && isAdmin();
    }

    // 4. Daily Point Conversions
    match /conversions/{conversionId} {
      allow get: if isValidId(conversionId) && (isAdmin() || (isSignedIn() && (resource == null || existing().userId == request.auth.uid)));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(conversionId) &&
        isSignedIn() &&
        isValidConversion(incoming()) &&
        incoming().conversionId == conversionId &&
        incoming().userId == request.auth.uid &&
        incoming().conversionDate == serverDateStr() &&
        incoming().createdAt == request.time &&
        isActiveUser(request.auth.uid);
      allow update, delete: if isValidId(conversionId) && isAdmin();
    }

    // 5. Pix Withdrawals
    match /withdrawals/{withdrawalId} {
      allow get: if isValidId(withdrawalId) && (isAdmin() || (isSignedIn() && (resource == null || existing().userId == request.auth.uid)));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(withdrawalId) &&
        isSignedIn() &&
        isValidWithdrawal(incoming()) &&
        incoming().withdrawalId == withdrawalId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().adminNote == '' &&
        incoming().pixTransactionId == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        validateWithdrawalCreateUser(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data,
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data,
          incoming()
        );
      allow update: if isValidId(withdrawalId) &&
        isAdmin() &&
        isValidWithdrawal(incoming()) &&
        incoming().withdrawalId == existing().withdrawalId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status in ['pending', 'approved'];
      allow delete: if isValidId(withdrawalId) && isAdmin();
    }

    // 6. Anti-Fraud Logs
    match /fraudLogs/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || (isSignedIn() && (resource == null || existing().userId == request.auth.uid)));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(logId) &&
        isSignedIn() &&
        isValidFraudEvent(incoming()) &&
        incoming().logId == logId &&
        (isAdmin() || incoming().userId == request.auth.uid) &&
        incoming().resolved == false &&
        incoming().createdAt == request.time;
      allow update: if isValidId(logId) &&
        isAdmin() &&
        isValidFraudEvent(incoming()) &&
        incoming().logId == existing().logId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(logId) && isAdmin();
    }

    // 7. Email Notifications Log
    match /emailNotifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isAdmin() || (isSignedIn() && (resource == null || existing().userId == request.auth.uid)));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(notificationId) &&
        isSignedIn() &&
        isValidEmailNotification(incoming()) &&
        incoming().notificationId == notificationId &&
        (isAdmin() || incoming().userId == request.auth.uid) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(notificationId) && isAdmin();
      allow delete: if isValidId(notificationId) && (
        isAdmin() || (isSignedIn() && existing().userId == request.auth.uid)
      );
    }

    // 8. Enterprise Financial Integrations (Owner-Only write access)
    match /integrations/{integrationId} {
      allow get: if isValidId(integrationId) && isPlatformOwner();
      allow list: if isPlatformOwner();
      allow create: if isValidId(integrationId) &&
        isPlatformOwner() &&
        isValidIntegration(incoming()) &&
        incoming().integrationId == integrationId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(integrationId) &&
        isPlatformOwner() &&
        isValidIntegration(incoming()) &&
        incoming().integrationId == existing().integrationId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(integrationId) && isPlatformOwner();
    }

    // 9. Global Leaderboard Projection (Zero PII, synced atomically with /users/{userId})
    match /leaderboard/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (resource == null || existing().status == 'active' || isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.brlBalanceCents >= 0 || resource.data.status == 'active' || isAdmin());

      allow create, update: if isValidId(userId) &&
        isSignedIn() &&
        isValidLeaderboardEntry(incoming()) &&
        incoming().uid == userId &&
        incoming().updatedAt == request.time && (
          isPlatformOwner() || (
            isAdmin() &&
            !isProtectedOwnerAccount(userId) &&
            (!('verifiedBadge' in incoming()) || incoming().verifiedBadge != 'owner')
          ) || (
            isOwner(userId) &&
            incoming().status in ['active', 'suspended', 'flagged'] &&
            matchesUserLeaderboard(
              userId,
              getAfter(/databases/$(database)/documents/users/$(userId)).data,
              incoming()
            )
          ) || (
            'lastMpMatchId' in getAfter(/databases/$(database)/documents/users/$(userId)).data &&
            existsAfter(/databases/$(database)/documents/multiplayerMatches/$(getAfter(/databases/$(database)/documents/users/$(userId)).data.lastMpMatchId)) &&
            request.auth.uid in getAfter(/databases/$(database)/documents/multiplayerMatches/$(getAfter(/databases/$(database)/documents/users/$(userId)).data.lastMpMatchId)).data.participantUids &&
            incoming().status in ['active', 'suspended'] &&
            matchesUserLeaderboard(
              userId,
              getAfter(/databases/$(database)/documents/users/$(userId)).data,
              incoming()
            )
          )
        );

      allow delete: if isValidId(userId) && (
        isPlatformOwner() || (isAdmin() && !isProtectedOwnerAccount(userId))
      );
    }

    // 10. Daily Random Check-ins (1 claim per server UTC date, ~1,000-1,200 pts/week, R$10 at 30-day consecutive streak)
    match /dailyCheckins/{checkinId} {
      allow get: if isValidId(checkinId) && (
        isAdmin() || (
          isSignedIn() && (
            checkinId.matches('^chk_' + request.auth.uid + '_.*') ||
            (resource != null && existing().userId == request.auth.uid)
          )
        )
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(checkinId) &&
        isSignedIn() &&
        isValidDailyCheckin(incoming()) &&
        incoming().checkinId == checkinId &&
        incoming().userId == request.auth.uid &&
        incoming().checkinDate == serverDateStr() &&
        checkinId == checkinDocId(request.auth.uid) &&
        incoming().createdAt == request.time &&
        isActiveUser(request.auth.uid) && (
          (
            !exists(/databases/$(database)/documents/dailyCheckins/$(yesterdayCheckinDocId(request.auth.uid))) &&
            incoming().streakDay == 1
          ) || (
            exists(/databases/$(database)/documents/dailyCheckins/$(yesterdayCheckinDocId(request.auth.uid))) &&
            validateYesterdayStreak(
              get(/databases/$(database)/documents/dailyCheckins/$(yesterdayCheckinDocId(request.auth.uid))).data,
              incoming().streakDay
            )
          )
        );
      allow update, delete: if isValidId(checkinId) && isAdmin();
    }

    // 11. Level-Up Rewards (Deterministic 1-time claim per level 2..6: lvl_{uid}_{level})
    match /levelRewards/{rewardId} {
      allow get: if isValidId(rewardId) && (
        isAdmin() || (
          isSignedIn() && (
            rewardId.matches('^lvl_' + request.auth.uid + '_.*') ||
            (resource != null && existing().userId == request.auth.uid)
          )
        )
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(rewardId) &&
        isSignedIn() &&
        isValidLevelReward(incoming()) &&
        incoming().rewardId == rewardId &&
        incoming().userId == request.auth.uid &&
        rewardId == levelRewardDocId(request.auth.uid, incoming().level) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        validateLevelRewardClaim(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data,
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data,
          incoming()
        );
      allow update, delete: if isValidId(rewardId) && isAdmin();
    }

    // 12. Referral Program (500 immediate signup pts + 12% ongoing earnings commission)
    match /referrals/{invitedUid} {
      allow get: if isValidId(invitedUid) && isSignedIn() && (
        isAdmin() || isOwner(invitedUid) || (resource != null && existing().referrerUid == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.referrerUid == request.auth.uid);

      allow create: if isValidId(invitedUid) &&
        isOwner(invitedUid) &&
        isValidReferral(incoming()) &&
        incoming().referralId == invitedUid &&
        incoming().invitedUid == invitedUid &&
        incoming().referrerUid != invitedUid &&
        incoming().signupBonusPoints == 500 &&
        incoming().commissionRatePct == 12 &&
        incoming().totalCommissionPointsEarned == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/users/$(invitedUid)).data.status == 'active' &&
        exists(/databases/$(database)/documents/leaderboard/$(incoming().referrerUid)) &&
        get(/databases/$(database)/documents/leaderboard/$(incoming().referrerUid)).data.status == 'active' &&
        existsAfter(/databases/$(database)/documents/users/$(incoming().referrerUid)) &&
        getAfter(/databases/$(database)/documents/users/$(incoming().referrerUid)).data.pointsBalance ==
          get(/databases/$(database)/documents/users/$(incoming().referrerUid)).data.pointsBalance + 500;

      allow update: if isValidId(invitedUid) &&
        isSignedIn() &&
        isValidReferral(incoming()) &&
        incoming().referralId == existing().referralId &&
        incoming().referrerUid == existing().referrerUid &&
        incoming().invitedUid == existing().invitedUid &&
        incoming().signupBonusPoints == existing().signupBonusPoints &&
        incoming().commissionRatePct == existing().commissionRatePct &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(invitedUid) &&
            isActiveUser(invitedUid) &&
            incoming().invitedDisplayName == existing().invitedDisplayName &&
            incoming().diff(existing()).affectedKeys().hasOnly(['totalCommissionPointsEarned', 'updatedAt']) &&
            incoming().totalCommissionPointsEarned > existing().totalCommissionPointsEarned &&
            incoming().totalCommissionPointsEarned <= existing().totalCommissionPointsEarned + 60 &&
            existsAfter(/databases/$(database)/documents/users/$(existing().referrerUid)) &&
            getAfter(/databases/$(database)/documents/users/$(existing().referrerUid)).data.pointsBalance ==
              get(/databases/$(database)/documents/users/$(existing().referrerUid)).data.pointsBalance +
              (incoming().totalCommissionPointsEarned - existing().totalCommissionPointsEarned)
          )
        );

      allow delete: if isValidId(invitedUid) && isAdmin();
    }

    // 13. Admin-Generated Promo Code Events (max 100,000 coins/points + scheduled publishAt)
    match /promoCodes/{code} {
      allow get: if isValidPromoCodeId(code) && isSignedIn();
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.active == true && resource.data.publicEvent == true
      );

      allow create: if isValidPromoCodeId(code) &&
        isAdmin() &&
        isValidPromoCode(incoming()) &&
        incoming().code == code &&
        incoming().redemptionCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidPromoCodeId(code) &&
        isSignedIn() &&
        isValidPromoCode(incoming()) &&
        incoming().code == existing().code &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            existing().active == true &&
            isPromoPublished(existing()) &&
            existing().redemptionCount < existing().maxRedemptions &&
            incoming().diff(existing()).affectedKeys().hasOnly(['redemptionCount', 'updatedAt']) &&
            incoming().redemptionCount == existing().redemptionCount + 1 &&
            isActiveUser(request.auth.uid) &&
            !exists(/databases/$(database)/documents/promoRedemptions/$(promoRedemptionDocId(request.auth.uid, code))) &&
            existsAfter(/databases/$(database)/documents/promoRedemptions/$(promoRedemptionDocId(request.auth.uid, code)))
          ) || isAdmin()
        );

      allow delete: if isValidPromoCodeId(code) && isAdmin();
    }

    // 14. Promo Code Redemptions (Deterministic one-time per user: prm_{uid}_{code})
    match /promoRedemptions/{redemptionId} {
      allow get: if isValidId(redemptionId) && (
        isAdmin() || (
          isSignedIn() && (
            redemptionId.matches('^prm_' + request.auth.uid + '_.*') ||
            (resource != null && existing().userId == request.auth.uid)
          )
        )
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(redemptionId) &&
        isSignedIn() &&
        isValidPromoRedemption(incoming()) &&
        incoming().redemptionId == redemptionId &&
        incoming().userId == request.auth.uid &&
        redemptionId == promoRedemptionDocId(request.auth.uid, incoming().code) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/promoCodes/$(incoming().code)) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        validatePromoRedemptionCreate(
          get(/databases/$(database)/documents/promoCodes/$(incoming().code)).data,
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data,
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data,
          incoming()
        );

      allow update, delete: if isValidId(redemptionId) && isAdmin();
    }

    // 15. Caixa de Correio Broadcast Messages (sent when admin creates promo code events)
    match /mailboxMessages/{messageId} {
      allow get: if isValidId(messageId) && ((isSignedIn() && (resource == null || existing().active == true)) || isAdmin());
      allow list: if (isSignedIn() && resource.data.active == true) || isAdmin();

      allow create: if isValidId(messageId) &&
        isAdmin() &&
        isValidMailboxMessage(incoming()) &&
        incoming().messageId == messageId &&
        incoming().createdAt == request.time;

      allow update: if isValidId(messageId) &&
        isAdmin() &&
        isValidMailboxMessage(incoming()) &&
        incoming().messageId == existing().messageId &&
        incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(messageId) && isAdmin();
    }

    // 16. Platform App Settings (Owner-Only write access: maintenance mode & withdrawal minimums)
    match /appSettings/{settingId} {
      allow get: if isValidId(settingId) && (
        settingId == 'maintenance' ||
        (settingId == 'withdrawal' && isSignedIn())
      );
      allow list: if isAdmin();

      allow create: if isValidId(settingId) &&
        isPlatformOwner() &&
        incoming().settingId == settingId &&
        incoming().updatedAt == request.time && (
          (settingId == 'withdrawal' && isValidWithdrawalSettings(incoming())) ||
          (settingId == 'maintenance' && isValidMaintenanceSettings(incoming()))
        );

      allow update: if isValidId(settingId) &&
        isPlatformOwner() &&
        incoming().settingId == existing().settingId &&
        incoming().updatedAt == request.time && (
          (settingId == 'withdrawal' && isValidWithdrawalSettings(incoming())) ||
          (settingId == 'maintenance' && isValidMaintenanceSettings(incoming()))
        );

      allow delete: if isValidId(settingId) && isPlatformOwner();
    }

    // 17. Pix Withdrawal Attempt Audit Logs (immutable append-only trail for anti-fraud)
    match /withdrawalAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && (isAdmin() || (isSignedIn() && (resource == null || existing().userId == request.auth.uid)));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(attemptId) &&
        isSignedIn() &&
        isValidWithdrawalAttemptLog(incoming()) &&
        incoming().attemptId == attemptId &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time && (
          isAdmin() || (
            incoming().userId == request.auth.uid &&
            incoming().status in [
              'submitted_pending', 'blocked_min_amount',
              'blocked_insufficient_balance', 'blocked_invalid_pix',
              'blocked_captcha', 'blocked_account_status',
              'failed_transaction'
            ] && (
              incoming().status != 'submitted_pending' || (
                isValidId(incoming().withdrawalId) &&
                existsAfter(/databases/$(database)/documents/withdrawals/$(incoming().withdrawalId))
              )
            )
          )
        );

      allow update: if false;
      allow delete: if isValidId(attemptId) && isAdmin();
    }

    // 18. Social Presence Heartbeats (online status in Friends tab)
    match /socialPresence/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(userId) &&
        isOwner(userId) &&
        incoming().keys().hasAll(['uid', 'lastSeen']) &&
        incoming().keys().hasOnly(['uid', 'lastSeen']) &&
        incoming().uid == userId &&
        incoming().lastSeen == request.time;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 19. Friend Requests (send, accept, reject, resend)
    match /friendRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (
        isAdmin() ||
        (resource == null && (requestId.matches('^' + request.auth.uid + '__.*') || requestId.matches('.*__' + request.auth.uid + '$'))) ||
        (resource != null && request.auth.uid in existing().participantUids)
      );
      allow list: if isSignedIn() && (
        isAdmin() || request.auth.uid in resource.data.participantUids
      );
      allow create: if isValidId(requestId) &&
        isSignedIn() &&
        isActiveUser(request.auth.uid) &&
        isValidFriendRequest(incoming()) &&
        incoming().senderUid == request.auth.uid &&
        requestId == sortedPairId(incoming().senderUid, incoming().recipientUid) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        !('respondedAt' in incoming());
      allow update: if isValidId(requestId) &&
        isSignedIn() &&
        isValidFriendRequest(incoming()) &&
        incoming().senderUid == existing().senderUid &&
        incoming().recipientUid == existing().recipientUid &&
        incoming().participantUids == existing().participantUids &&
        incoming().senderName == existing().senderName &&
        incoming().recipientName == existing().recipientName && (
          isAdmin() || (
            request.auth.uid == existing().recipientUid &&
            existing().status == 'pending' &&
            incoming().status in ['accepted', 'rejected'] &&
            incoming().createdAt == existing().createdAt &&
            incoming().respondedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'respondedAt'])
          ) || (
            request.auth.uid == existing().senderUid &&
            existing().status == 'rejected' &&
            incoming().status == 'pending' &&
            incoming().createdAt == request.time &&
            (!('respondedAt' in incoming()) || incoming().respondedAt == null) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'createdAt', 'respondedAt'])
          )
        );
      allow delete: if isValidId(requestId) && (
        isAdmin() || (isSignedIn() && request.auth.uid in existing().participantUids)
      );
    }

    // 20. Confirmed Friendships & Private 1-on-1 Messages
    match /friendships/{chatId} {
      allow get: if isValidId(chatId) && isSignedIn() && (
        isAdmin() ||
        (resource == null && (chatId.matches('^' + request.auth.uid + '__.*') || chatId.matches('.*__' + request.auth.uid + '$'))) ||
        (resource != null && request.auth.uid in existing().memberUids)
      );
      allow list: if isSignedIn() && (
        isAdmin() || request.auth.uid in resource.data.memberUids
      );
      allow create: if isValidId(chatId) &&
        isSignedIn() &&
        isValidFriendship(incoming()) &&
        request.auth.uid in incoming().memberUids &&
        chatId == sortedPairId(incoming().memberUids[0], incoming().memberUids[1]) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/friendRequests/$(chatId)) &&
        getAfter(/databases/$(database)/documents/friendRequests/$(chatId)).data.status == 'accepted';
      allow update: if false;
      allow delete: if isValidId(chatId) && (
        isAdmin() || (isSignedIn() && request.auth.uid in existing().memberUids)
      );

      match /messages/{messageId} {
        allow get: if isValidId(chatId) && isValidId(messageId) && isSignedIn() && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.memberUids
        );
        allow list: if isValidId(chatId) && isSignedIn() && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.memberUids
        );
        allow create: if isValidId(chatId) &&
          isValidId(messageId) &&
          isSignedIn() &&
          isActiveUser(request.auth.uid) &&
          request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.memberUids &&
          isValidSocialMessage(incoming()) &&
          !('readAt' in incoming()) &&
          !('readBy' in incoming()) &&
          incoming().senderUid == request.auth.uid &&
          incoming().createdAt == request.time && (
            !('messageType' in incoming()) ||
            incoming().messageType == 'text' ||
            (('mediaDataUrl' in incoming()) && isValidPrivateMediaDataUrl(incoming().mediaDataUrl))
          );
        allow update: if isValidId(chatId) &&
          isValidId(messageId) &&
          isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.memberUids &&
          request.auth.uid != existing().senderUid &&
          (!('readAt' in existing()) || existing().readAt == null) &&
          isValidSocialMessage(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['readAt', 'readBy']) &&
          incoming().readAt == request.time &&
          incoming().readBy == request.auth.uid;
        allow delete: if isValidId(chatId) && isValidId(messageId) && isAdmin();
      }
    }

    // 21. Global Community Chat (strictly text-only)
    match /globalMessages/{messageId} {
      allow get: if isValidId(messageId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(messageId) &&
        isSignedIn() &&
        isActiveUser(request.auth.uid) &&
        isValidSocialMessage(incoming()) &&
        !('mediaDataUrl' in incoming()) &&
        !('audioDurationSec' in incoming()) &&
        (!('messageType' in incoming()) || incoming().messageType == 'text') &&
        !('readAt' in incoming()) &&
        !('readBy' in incoming()) &&
        incoming().senderUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(messageId) && isAdmin();
    }

    // 22. Support Tickets (AI Biel Triage -> Human Specialist Admin Queue)
    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && (
        isAdmin() || (isSignedIn() && (resource == null || existing().userId == request.auth.uid))
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(ticketId) &&
        isSignedIn() &&
        isValidSupportTicket(incoming()) &&
        incoming().ticketId == ticketId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'waiting_human' &&
        incoming().assignedAdminUid == '' &&
        incoming().assignedAdminName == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(ticketId) &&
        isSignedIn() &&
        isValidSupportTicket(incoming()) &&
        incoming().ticketId == existing().ticketId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(existing().userId) &&
            existing().status != 'closed' && (
              (
                incoming().status == 'closed' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              ) || (
                incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt'])
              )
            )
          )
        );

      allow delete: if isValidId(ticketId) && isAdmin();

      match /messages/{messageId} {
        allow get: if isValidId(ticketId) && isValidId(messageId) && (
          isAdmin() || (
            isSignedIn() &&
            get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid
          )
        );
        allow list: if isValidId(ticketId) && (
          isAdmin() || (
            isSignedIn() &&
            get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid
          )
        );
        allow create: if isValidId(ticketId) &&
          isValidId(messageId) &&
          isSignedIn() &&
          isValidSupportMessage(incoming()) &&
          incoming().messageId == messageId &&
          incoming().ticketId == ticketId &&
          incoming().senderUid == request.auth.uid &&
          incoming().createdAt == request.time && (
            (
              existsAfter(/databases/$(database)/documents/supportTickets/$(ticketId)) &&
              canCreateUserSupportMessage(
                getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data,
                incoming()
              )
            ) || (
              incoming().senderRole == 'admin' &&
              isAdmin()
            )
          );
        allow update, delete: if false;
      }
    }

    // 23. Authoritative Online Multiplayer Matches & Wager Settlement
    match /multiplayerMatches/{matchId} {
      allow get: if isValidId(matchId) && isSignedIn() && (
        isAdmin() || resource == null || request.auth.uid in existing().participantUids
      );
      allow list: if isSignedIn() && (
        isAdmin() || request.auth.uid in resource.data.participantUids
      );
      allow create: if isValidId(matchId) &&
        isSignedIn() &&
        isValidMultiplayerMatch(incoming()) &&
        incoming().matchId == matchId &&
        incoming().settledByUid == request.auth.uid &&
        request.auth.uid in incoming().participantUids &&
        incoming().createdAt == request.time && (
          incoming().stakePoints == 0 || (
            incoming().winnerUid != '' &&
            incoming().loserUid != '' &&
            incoming().winnerUid in incoming().participantUids &&
            incoming().loserUid in incoming().participantUids &&
            incoming().winnerUid != incoming().loserUid &&
            getAfter(/databases/$(database)/documents/users/$(incoming().winnerUid)).data.lastMpMatchId == matchId &&
            getAfter(/databases/$(database)/documents/users/$(incoming().loserUid)).data.lastMpMatchId == matchId
          )
        );
      allow update, delete: if isValidId(matchId) && isAdmin();
    }

    // 24. Facial Identity Verification Submissions (Private PII: Owner + Admin only)
    match /faceVerifications/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isActiveUser(userId) &&
        isValidFaceVerification(incoming()) &&
        incoming().uid == userId &&
        incoming().status == 'pending' &&
        incoming().rejectionReason == '' &&
        incoming().bonusAwarded == false &&
        incoming().reviewedBy == '' &&
        incoming().submittedAt == request.time &&
        incoming().reviewedAt == null &&
        (!('identityVerified' in get(/databases/$(database)/documents/users/$(userId)).data) || get(/databases/$(database)/documents/users/$(userId)).data.identityVerified != true);

      allow update: if isValidId(userId) &&
        isSignedIn() &&
        isValidFaceVerification(incoming()) &&
        (!('uid' in existing()) || incoming().uid == existing().uid) &&
        incoming().uid == userId && (
          (
            isOwner(userId) &&
            isActiveUser(userId) &&
            (!('status' in existing()) || existing().status != 'approved') &&
            (!('bonusAwarded' in existing()) || existing().bonusAwarded == false) &&
            incoming().status == 'pending' &&
            incoming().rejectionReason == '' &&
            incoming().bonusAwarded == false &&
            incoming().reviewedBy == '' &&
            incoming().submittedAt == request.time &&
            incoming().reviewedAt == null &&
            (!('identityVerified' in get(/databases/$(database)/documents/users/$(userId)).data) || get(/databases/$(database)/documents/users/$(userId)).data.identityVerified != true)
          ) || (
            isAdmin() &&
            incoming().submittedAt == existing().submittedAt &&
            incoming().reviewedAt == request.time && (
              (
                incoming().status == 'approved' &&
                existing().bonusAwarded == false &&
                incoming().bonusAwarded == true
              ) || (
                incoming().status == 'rejected' &&
                incoming().bonusAwarded == existing().bonusAwarded &&
                incoming().rejectionReason.size() >= 3
              )
            )
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // 25. Blue Verified Badge Requests (Private PII: Owner + Admin only)
    match /verificationRequests/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isActiveUser(userId) &&
        isValidVerificationRequest(incoming()) &&
        incoming().uid == userId &&
        incoming().status == 'pending' &&
        incoming().rejectionReason == '' &&
        incoming().reviewedBy == '' &&
        incoming().submittedAt == request.time &&
        incoming().reviewedAt == null &&
        (!('identityVerified' in get(/databases/$(database)/documents/users/$(userId)).data) || get(/databases/$(database)/documents/users/$(userId)).data.identityVerified != true) &&
        (!('verifiedBadge' in get(/databases/$(database)/documents/users/$(userId)).data) || get(/databases/$(database)/documents/users/$(userId)).data.verifiedBadge == null || get(/databases/$(database)/documents/users/$(userId)).data.verifiedBadge == 'none');

      allow update: if isValidId(userId) &&
        isSignedIn() &&
        isValidVerificationRequest(incoming()) &&
        (!('uid' in existing()) || incoming().uid == existing().uid) &&
        incoming().uid == userId && (
          (
            isOwner(userId) &&
            isActiveUser(userId) &&
            (!('status' in existing()) || existing().status != 'approved') &&
            incoming().status == 'pending' &&
            incoming().rejectionReason == '' &&
            incoming().reviewedBy == '' &&
            incoming().submittedAt == request.time &&
            incoming().reviewedAt == null &&
            (!('identityVerified' in get(/databases/$(database)/documents/users/$(userId)).data) || get(/databases/$(database)/documents/users/$(userId)).data.identityVerified != true)
          ) || (
            isAdmin() &&
            incoming().submittedAt == existing().submittedAt &&
            incoming().reviewedAt == request.time && (
              incoming().status == 'approved' ||
              (incoming().status == 'rejected' && incoming().rejectionReason.size() >= 3)
            )
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // 26. In-App Casino Sessions (Double & Mines wagered strictly with points or Earn Easy BRL balance)
    match /casinoSessions/{sessionId} {
      allow get: if isValidId(sessionId) && (isAdmin() || (isSignedIn() && (resource == null || existing().userId == request.auth.uid)));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(sessionId) &&
        isSignedIn() &&
        isValidCasinoSession(incoming()) &&
        incoming().sessionId == sessionId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        isActiveUser(request.auth.uid) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastCasinoSessionId == sessionId && (
          (
            incoming().gameType == 'double' &&
            incoming().status in ['won', 'lost'] &&
            incoming().settledAt == request.time
          ) || (
            incoming().gameType == 'mines' &&
            incoming().status == 'active' &&
            incoming().payoutAmount == 0 &&
            incoming().settledAt == null
          )
        );

      allow update: if isValidId(sessionId) &&
        isSignedIn() &&
        isValidCasinoSession(incoming()) &&
        incoming().sessionId == existing().sessionId &&
        incoming().userId == existing().userId &&
        incoming().gameType == existing().gameType &&
        incoming().currency == existing().currency &&
        incoming().stakeAmount == existing().stakeAmount &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() || (
            existing().userId == request.auth.uid &&
            existing().gameType == 'mines' &&
            existing().status == 'active' &&
            incoming().status in ['won', 'lost'] &&
            incoming().settledAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'payoutAmount', 'multiplier', 'details', 'integrityHash', 'settledAt'
            ])
          )
        );

      allow delete: if isValidId(sessionId) && isAdmin();
    }
  }
}
