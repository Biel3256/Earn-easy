# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SMTP Configuration (Optional: enables real outbound transactional emails via Nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Earn Easy <no-reply@earneasy.app>"

# Enterprise API Key Secret for external ERP/BI integrations
ENTERPRISE_API_KEY=""
