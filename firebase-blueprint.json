{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Public wallet and gameplay statistics for an authenticated Earn Easy player.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 60000 },
        "pointsBalance": { "type": "number" },
        "lifetimePoints": { "type": "number" },
        "brlBalanceCents": { "type": "number" },
        "totalWithdrawnCents": { "type": "number" },
        "lastConversionDate": { "type": "string", "maxLength": 10, "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
        "status": { "type": "string", "enum": ["active", "suspended", "flagged"] },
        "riskScore": { "type": "number" },
        "gamesPlayed": { "type": "number" },
        "banReason": { "type": "string", "maxLength": 120 },
        "banExplanation": { "type": "string", "maxLength": 400 },
        "bannedBy": { "type": "string", "maxLength": 160 },
        "lastPromoCode": { "type": "string", "maxLength": 128 },
        "firstWithdrawalUsed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "photoURL",
        "pointsBalance",
        "lifetimePoints",
        "brlBalanceCents",
        "totalWithdrawnCents",
        "lastConversionDate",
        "status",
        "riskScore",
        "gamesPlayed",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII and default Pix payout configuration for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "defaultPixKeyType": { "type": "string", "enum": ["none", "cpf", "email", "phone", "random"] },
        "defaultPixKey": { "type": "string", "maxLength": 140 },
        "deviceFingerprint": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "defaultPixKeyType", "defaultPixKey", "deviceFingerprint", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Explicit administrator privilege document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "Verified gameplay session awarding points with anti-fraud metadata.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "gameCategory": { "type": "string", "enum": ["tic_tac_toe", "dot_link", "word_search", "math_sprint", "memory_match", "quick_reflex", "high_low_cards"] },
        "scoreEarned": { "type": "number" },
        "durationMs": { "type": "number" },
        "movesCount": { "type": "number" },
        "integrityHash": { "type": "string", "minLength": 16, "maxLength": 128 },
        "verificationStatus": { "type": "string", "enum": ["verified", "flagged", "rejected"] },
        "fraudReason": { "type": "string", "maxLength": 200 },
        "playedDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "sessionId",
        "userId",
        "gameCategory",
        "scoreEarned",
        "durationMs",
        "movesCount",
        "integrityHash",
        "verificationStatus",
        "fraudReason",
        "playedDate",
        "createdAt"
      ]
    },
    "PointConversion": {
      "title": "PointConversion",
      "description": "Once-per-day conversion of points (1,000 pts = R$ 0.10 / 10 cents) into BRL balance.",
      "type": "object",
      "properties": {
        "conversionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pointsConverted": { "type": "number" },
        "brlCentsCredited": { "type": "number" },
        "conversionDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "captchaVerified": { "type": "boolean" },
        "integrityToken": { "type": "string", "minLength": 12, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "conversionId",
        "userId",
        "pointsConverted",
        "brlCentsCredited",
        "conversionDate",
        "captchaVerified",
        "integrityToken",
        "createdAt"
      ]
    },
    "PixWithdrawal": {
      "title": "PixWithdrawal",
      "description": "Pix payout request (first withdrawal default R$ 0.10 / 10 cents; configurable 1 to 2000 cents via admin panel).",
      "type": "object",
      "properties": {
        "withdrawalId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userDisplayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "amountCents": { "type": "number" },
        "pixKeyType": { "type": "string", "enum": ["cpf", "email", "phone", "random"] },
        "pixKey": { "type": "string", "minLength": 5, "maxLength": 140 },
        "status": { "type": "string", "enum": ["pending", "approved", "paid", "rejected"] },
        "fraudCheckPassed": { "type": "boolean" },
        "adminNote": { "type": "string", "maxLength": 300 },
        "pixTransactionId": { "type": "string", "maxLength": 120 },
        "requestedDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "withdrawalId",
        "userId",
        "userDisplayName",
        "amountCents",
        "pixKeyType",
        "pixKey",
        "status",
        "fraudCheckPassed",
        "adminNote",
        "pixTransactionId",
        "requestedDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "FraudEvent": {
      "title": "FraudEvent",
      "description": "Anti-fraud anomaly and security audit log entry.",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventType": { "type": "string", "enum": ["speed_anomaly", "score_cap_exceeded", "double_conversion_attempt", "bot_challenge_failed", "suspicious_withdrawal", "manual_flag", "profanity_username_ban", "admin_ban"] },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "details": { "type": "string", "minLength": 3, "maxLength": 400 },
        "resolved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["logId", "userId", "eventType", "severity", "details", "resolved", "createdAt"]
    },
    "EmailNotification": {
      "title": "EmailNotification",
      "description": "Transactional email notification log confirming conversions and Pix payouts.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "eventType": { "type": "string", "enum": ["conversion_confirmed", "withdrawal_requested", "withdrawal_approved", "withdrawal_paid", "withdrawal_rejected", "streak_bonus_credited", "invite_sent", "referral_welcome", "referral_bonus_credited"] },
        "subject": { "type": "string", "minLength": 3, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 3, "maxLength": 500 },
        "deliveryStatus": { "type": "string", "enum": ["sent_smtp", "logged_in_app", "failed"] },
        "referenceId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "notificationId",
        "userId",
        "recipientEmail",
        "eventType",
        "subject",
        "summary",
        "deliveryStatus",
        "referenceId",
        "createdAt"
      ]
    },
    "EnterpriseIntegration": {
      "title": "EnterpriseIntegration",
      "description": "External financial ERP/API webhook and key configuration managed by admins.",
      "type": "object",
      "properties": {
        "integrationId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "providerType": { "type": "string", "enum": ["erp_webhook", "accounting_api", "pix_gateway", "bi_export"] },
        "endpointUrl": { "type": "string", "maxLength": 300 },
        "apiKeyPrefix": { "type": "string", "maxLength": 24 },
        "apiKeyHash": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "lastTriggeredAt": { "type": "string", "maxLength": 40 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "integrationId",
        "name",
        "providerType",
        "endpointUrl",
        "apiKeyPrefix",
        "apiKeyHash",
        "active",
        "lastTriggeredAt",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Zero-PII public leaderboard projection for top Earn Easy players sorted by BRL balance.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 60000 },
        "brlBalanceCents": { "type": "number" },
        "pointsBalance": { "type": "number" },
        "lifetimePoints": { "type": "number" },
        "gamesPlayed": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended", "flagged"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "photoURL",
        "brlBalanceCents",
        "pointsBalance",
        "gamesPlayed",
        "status",
        "updatedAt"
      ]
    },
    "DailyCheckin": {
      "title": "DailyCheckin",
