      },
      "required": ["rewardId", "userId", "level", "rewardPoints", "xpAtClaim", "createdAt"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Verified referral link relationship granting 500 immediate points to referrer plus 12% commission on invited user's point earnings.",
      "type": "object",
