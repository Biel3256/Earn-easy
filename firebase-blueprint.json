      },
      "required": [
        "ticketId",
        "userId",
        "userDisplayName",
        "topic",
        "subject",
        "bielSummary",
        "status",
        "assignedAdminUid",
        "assignedAdminName",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Live message inside a support ticket (player, Biel triage context, or admin specialist).",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ticketId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "senderRole": { "type": "string", "enum": ["user", "biel", "admin"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 800 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "messageId",
        "ticketId",
        "senderUid",
        "senderName",
        "senderRole",
        "text",
        "createdAt"
      ]
    },
    "MaintenanceSettings": {
      "title": "MaintenanceSettings",
      "description": "Admin-managed platform maintenance banner/lock configuration stored at appSettings/maintenance.",
      "type": "object",
      "properties": {
        "settingId": { "type": "string", "maxLength": 32, "pattern": "^maintenance$" },
        "enabled": { "type": "boolean" },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "message": { "type": "string", "minLength": 3, "maxLength": 500 },
        "estimatedReturn": { "type": "string", "maxLength": 120 },
        "updatedBy": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "settingId",
        "enabled",
        "title",
        "message",
        "estimatedReturn",
        "updatedBy",
        "updatedAt"
      ]
    },
    "DeletedMailboxEntry": {
      "title": "DeletedMailboxEntry",
      "description": "Per-user dismissal/deletion marker for global Caixa de Correio messages.",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["messageId", "deletedAt"]
    }
  },
