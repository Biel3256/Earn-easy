        "invitedUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invitedDisplayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "signupBonusPoints": { "type": "number" },
        "commissionRatePct": { "type": "number" },
