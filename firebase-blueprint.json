        "promoCode": { "type": "string", "maxLength": 40 },
        "pointsValue": { "type": "number" },
        "publishAt": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "messageId",
        "title",
        "body",
        "category",
        "promoCode",
        "pointsValue",
        "publishAt",
        "active",
        "createdBy",
        "createdAt"
      ]
    },
    "WithdrawalSettings": {
      "title": "WithdrawalSettings",
      "description": "Admin-managed Pix withdrawal minimums (first withdrawal and standard minimum between 1 and 2000 cents) and quick amount buttons.",
      "type": "object",
      "properties": {
        "settingId": { "type": "string", "maxLength": 32, "pattern": "^withdrawal$" },
        "firstWithdrawalMinCents": { "type": "number" },
        "standardWithdrawalMinCents": { "type": "number" },
        "quickAmountsCents": { "type": "array" },
        "updatedBy": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "settingId",
        "firstWithdrawalMinCents",
        "standardWithdrawalMinCents",
        "quickAmountsCents",
        "updatedBy",
        "updatedAt"
      ]
    },
    "WithdrawalAttemptLog": {
      "title": "WithdrawalAttemptLog",
      "description": "Immutable anti-fraud audit log recording every Pix withdrawal attempt (submitted, blocked, failed, or admin-processed) with status, timestamp, and userId.",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userDisplayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "withdrawalId": { "type": "string", "maxLength": 128 },
        "amountCents": { "type": "number" },
        "pixKeyType": { "type": "string", "enum": ["none", "cpf", "email", "phone", "random"] },
        "pixKey": { "type": "string", "maxLength": 140 },
        "status": {
          "type": "string",
          "enum": [
            "submitted_pending",
            "approved",
            "paid",
            "rejected",
            "blocked_min_amount",
