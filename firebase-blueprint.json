            "blocked_invalid_pix",
            "blocked_captcha",
            "blocked_account_status",
            "failed_transaction"
          ]
        },
        "details": { "type": "string", "minLength": 2, "maxLength": 300 },
        "deviceFingerprint": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "attemptId",
        "userId",
        "userDisplayName",
        "withdrawalId",
        "amountCents",
        "pixKeyType",
        "pixKey",
        "status",
        "details",
        "deviceFingerprint",
        "actorUid",
        "createdAt"
      ]
    },
