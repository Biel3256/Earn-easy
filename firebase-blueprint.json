        "invitedDisplayName",
        "signupBonusPoints",
        "commissionRatePct",
        "totalCommissionPointsEarned",
        "createdAt",
        "updatedAt"
      ]
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "Admin-generated promotional event code worth up to 100,000 redeemable coins/points with optional scheduled publish delay.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[A-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "pointsValue": { "type": "number" },
        "maxRedemptions": { "type": "number" },
        "redemptionCount": { "type": "number" },
        "active": { "type": "boolean" },
        "publicEvent": { "type": "boolean" },
        "publishDelayMinutes": { "type": "number" },
        "publishAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "code",
        "title",
        "pointsValue",
        "maxRedemptions",
        "redemptionCount",
        "active",
        "publicEvent",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "PromoRedemption": {
      "title": "PromoRedemption",
      "description": "Deterministic one-time redemption of an admin promo code per user (prm_{uid}_{code}).",
      "type": "object",
      "properties": {
        "redemptionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[A-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pointsAwarded": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["redemptionId", "code", "userId", "pointsAwarded", "createdAt"]
    },
    "MailboxMessage": {
      "title": "MailboxMessage",
      "description": "Admin-dispatched inbox message delivered to users' Caixa de Correio when a promo code event is generated.",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
