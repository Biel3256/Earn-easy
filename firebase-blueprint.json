      "type": "object",
      "properties": {
        "checkinId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "checkinDate": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "pointsAwarded": { "type": "number" },
        "weekTotalAfter": { "type": "number" },
        "streakDay": { "type": "number" },
        "brlBonusCents": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "checkinId",
        "userId",
        "checkinDate",
        "pointsAwarded",
        "weekTotalAfter",
        "streakDay",
        "brlBonusCents",
        "createdAt"
      ]
    },
    "LevelReward": {
      "title": "LevelReward",
      "description": "One-time level-up bonus reward claimed by a player upon reaching a target XP threshold.",
      "type": "object",
      "properties": {
        "rewardId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "level": { "type": "number" },
        "rewardPoints": { "type": "number" },
        "xpAtClaim": { "type": "number" },
